Base64ToFile(b64, path) {
    DllCall("crypt32\CryptStringToBinaryW", "Str", b64, "UInt", 0, "UInt", 1, "Ptr", 0, "UInt*", &n := 0, "Ptr", 0, "Ptr", 0)
    buf := Buffer(n)
    DllCall("crypt32\CryptStringToBinaryW", "Str", b64, "UInt", 0, "UInt", 1, "Ptr", buf, "UInt*", &n, "Ptr", 0, "Ptr", 0)
    f := FileOpen(path, "w"), f.RawWrite(buf, n), f.Close()
}

; ---- logo animado (anel de tinta) na barra lateral ----
; as 141 imagens ficam numa folha só (ring.png); aqui cada quadro vira um bitmap já composto sobre a cor da barra
RingInit() {
    global g, ASSET_DIR, C_SIDE, ringFr, ringCtl, RING_N, RING_COLS, RING_S
    try {
        hbm := LoadPicture(ASSET_DIR "\ring.png", "GDI+")
        if !hbm
            return false
        k := A_ScreenDPI / 96
        D := Round(46 * k)
        hdcS := DllCall("GetDC", "Ptr", 0, "Ptr")
        sheet := DllCall("CreateCompatibleDC", "Ptr", hdcS, "Ptr")
        DllCall("SelectObject", "Ptr", sheet, "Ptr", hbm)
        r := Integer("0x" SubStr(C_SIDE, 1, 2)), gg := Integer("0x" SubStr(C_SIDE, 3, 2)), bb := Integer("0x" SubStr(C_SIDE, 5, 2))
        light := (r + gg + bb) > 384
        brush := DllCall("CreateSolidBrush", "UInt", (bb << 16) | (gg << 8) | r, "Ptr")
        rc := Buffer(16, 0), NumPut("Int", D, "Int", D, rc, 8)
        rop := light ? 0x00220326 : 0x00EE0086       ; claro: anel escuro (dest & ~src); escuro: anel claro (dest | src)
        Loop RING_N {
            i := A_Index - 1
            mdc := DllCall("CreateCompatibleDC", "Ptr", hdcS, "Ptr")
            fb := DllCall("CreateCompatibleBitmap", "Ptr", hdcS, "Int", D, "Int", D, "Ptr")
            old := DllCall("SelectObject", "Ptr", mdc, "Ptr", fb, "Ptr")
            DllCall("FillRect", "Ptr", mdc, "Ptr", rc, "Ptr", brush)
            DllCall("SetStretchBltMode", "Ptr", mdc, "Int", 4)
            DllCall("StretchBlt", "Ptr", mdc, "Int", 0, "Int", 0, "Int", D, "Int", D
                , "Ptr", sheet, "Int", Mod(i, RING_COLS) * RING_S, "Int", (i // RING_COLS) * RING_S, "Int", RING_S, "Int", RING_S, "UInt", rop)
            DllCall("SelectObject", "Ptr", mdc, "Ptr", old)
            DllCall("DeleteDC", "Ptr", mdc)
            ringFr.Push(fb)
        }
        DllCall("DeleteObject", "Ptr", brush)
        DllCall("DeleteDC", "Ptr", sheet)
        DllCall("DeleteObject", "Ptr", hbm)
        DllCall("ReleaseDC", "Ptr", 0, "Ptr", hdcS)
        ringCtl := g.Add("Picture", "x18 y20 w46 h46", ASSET_DIR "\side.png")
        old1 := SendMessage(0x172, 0, ringFr[1], ringCtl.Hwnd)
        if old1
            DllCall("DeleteObject", "Ptr", old1)
        SetTimer(RingTick, 60)
        return true
    }
    return false
}

RingTick() {
    global g, ringFr, ringCtl, ringIdx, chkLogoAnim, appStarted
    if (!IsObject(ringCtl) || ringFr.Length = 0)
        return
    if (IsObject(chkLogoAnim) && !chkLogoAnim.Value)
        return
    if (!DllCall("IsWindowVisible", "Ptr", g.Hwnd) || WinGetMinMax(g.Hwnd) = -1)
        return
    ringIdx := Mod(ringIdx + 1, ringFr.Length)
    SendMessage(0x172, 0, ringFr[ringIdx + 1], ringCtl.Hwnd)
}

