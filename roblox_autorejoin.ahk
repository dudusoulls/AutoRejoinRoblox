    Loop bgCtrls.Length {
        c := bgCtrls[bgCtrls.Length - A_Index + 1]
        DllCall("SetWindowPos", "Ptr", c.Hwnd, "Ptr", 1, "Int", 0, "Int", 0, "Int", 0, "Int", 0, "UInt", 0x13)
