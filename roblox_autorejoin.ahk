            FadeShow(gm, "NoActivate w284 h52 x" (x > 0 ? x : 0) " y8")
        } else
            FadeShow(gm, "NoActivate")
    } else {
        FadeHide(gm)
        FadeShow(g, Format("w{} h{}", W, H))
    }
}

