    for hw in [g.Hwnd, gm.Hwnd, gk.Hwnd] {
        DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", hw, "UInt", 33, "Int*", 2, "UInt", 4)          ; cantos arredondados (Win11)
