; mistura duas cores "RRGGBB" (t = 0 fica na primeira, 1 na segunda)
MixCol(a, b, t) {
    r := ""
    for i in [1, 3, 5] {
        va := Integer("0x" SubStr(a, i, 2)), vb := Integer("0x" SubStr(b, i, 2))
        r .= Format("{:02X}", Round(va + (vb - va) * t))
    }
    return r
}

