; cor "de verdade" do texto na tela: pega a cor viva mais comum dentro do retângulo (coords do cliente do Roblox)
SampleTextColor(hw, rx, ry, rw, rh) {
    pt := Buffer(8, 0)
    NumPut("Int", rx, pt, 0), NumPut("Int", ry, pt, 4)
    DllCall("ClientToScreen", "Ptr", hw, "Ptr", pt)
    sx := NumGet(pt, 0, "Int"), sy := NumGet(pt, 4, "Int")
    dc := DllCall("GetDC", "Ptr", 0, "Ptr")
    if !dc
        return ""
    cnt := Map(), sum := Map()
    sxp := Max(1, rw // 50), syp := Max(1, rh // 10)
    yy := 0
    while (yy < rh) {
        xx := 0
        while (xx < rw) {
            c := DllCall("GetPixel", "Ptr", dc, "Int", sx + xx, "Int", sy + yy, "UInt")
            if (c != 0xFFFFFFFF) {
                r := c & 0xFF, g := (c >> 8) & 0xFF, b := (c >> 16) & 0xFF
                mx := Max(r, g, b), mn := Min(r, g, b)
                if (mx >= 140 && mx - mn >= 60) {
                    key := (r // 40) "," (g // 40) "," (b // 40)
                    if !cnt.Has(key)
                        cnt[key] := 0, sum[key] := [0, 0, 0]
                    cnt[key]++
                    sum[key][1] += r, sum[key][2] += g, sum[key][3] += b
                }
            }
            xx += sxp
        }
        yy += syp
    }
    DllCall("ReleaseDC", "Ptr", 0, "Ptr", dc)
    bk := "", bn := 0
    for key, n in cnt
        if (n > bn)
            bn := n, bk := key
    if (bk = "" || bn < 3)
        return ""
    sm := sum[bk]
    return Format("{:02X}{:02X}{:02X}", sm[1] // bn, sm[2] // bn, sm[3] // bn)
}

LineRect(line) {
    x1 := 99999, y1 := 99999, x2 := 0, y2 := 0
    for wd in line.Words {
        x1 := Min(x1, wd.x), y1 := Min(y1, wd.y)
        x2 := Max(x2, wd.x + wd.w), y2 := Max(y2, wd.y + wd.h)
    }
    return [x1, y1, x2 - x1, y2 - y1]
}

; ---------- áreas de leitura (ajustáveis pelo usuário, guardadas em proporção da janela do Roblox) ----------
; devolve a área em proporção da janela ATUAL. Se "ajustar ao tamanho da janela" estiver ligado, converte do tamanho em que foi marcada
; (o texto do Roblox cresce junto com a altura; esquerda/centro seguem o canto/centro da janela)
AreaGet(name, cw := 0, ch := 0) {
    global areaDef, iniFile, areaAnchor, chkAreaScale
    d := areaDef[name], r := []
    for i, k in ["x", "y", "w", "h"] {
        v := IniRead(iniFile, "area", name "_" k, "")
        r.Push(v != "" && IsNumber(v) ? Float(v) : d[i])
    }
    rw := IniRead(iniFile, "area", name "_rw", ""), rh := IniRead(iniFile, "area", name "_rh", "")
    if (cw > 0 && ch > 0 && IsNumber(rw) && IsNumber(rh) && Integer(rw) > 0 && Integer(rh) > 0 && IsObject(chkAreaScale) && chkAreaScale.Value
        && (cw != Integer(rw) || ch != Integer(rh))) {
        rw := Integer(rw), rh := Integer(rh)
        ; UI de jogos do Roblox costuma escalar pelo MENOR lado (janela mais estreita que a original encolhe pela largura)
        sc := Min(ch / rh, cw / rw)
        ; âncora automática: onde o centro da área estava (esquerda/centro/direita, topo/meio/baixo)
        cxr := r[1] + r[3] / 2, cyr := r[2] + r[4] / 2
        an := cxr < 0.33 ? 0 : (cxr > 0.67 ? 2 : 1)
        anY := cyr < 0.33 ? 0 : (cyr > 0.67 ? 2 : 1)
        axRef := an * rw / 2, axCur := an * cw / 2
        ayRef := anY * rh / 2, ayCur := anY * ch / 2
        x := axCur + (r[1] * rw - axRef) * sc, y := ayCur + (r[2] * rh - ayRef) * sc
        w := r[3] * rw * sc, h := r[4] * rh * sc
        ; folga de 6% pra absorver diferença de proporção (só quando o tamanho mudou)
        x -= w * 0.03, y -= h * 0.03, w *= 1.06, h *= 1.06
        x := Max(0, Min(cw - 8, x)), y := Max(0, Min(ch - 8, y))
        w := Max(8, Min(w, cw - x)), h := Max(8, Min(h, ch - y))
        return [x / cw, y / ch, w / cw, h / ch]
    }
    return r
}

AreaIsSet(name) {
    global iniFile
    return IniRead(iniFile, "area", name "_x", "") != ""
}

AreaReset(name, *) {
    global iniFile, areaRes
    for k in ["x", "y", "w", "h", "rw", "rh"]
        IniDelete(iniFile, "area", name "_" k)
    if IsObject(areaRes)
        areaRes.Value := TT("area_reset_ok")
}

AreaDraw(u) {
    k := A_ScreenDPI / 96
    u.fill.Move(u.x, u.y, u.w, u.h)
    u.frm.Move(u.x, u.y, u.w, u.h)
    t := Max(2, Round(2 * k))
    outer := DllCall("CreateRectRgn", "Int", 0, "Int", 0, "Int", u.w, "Int", u.h, "Ptr")
    inner := DllCall("CreateRectRgn", "Int", t, "Int", t, "Int", Max(t + 1, u.w - t), "Int", Max(t + 1, u.h - t), "Ptr")
    DllCall("CombineRgn", "Ptr", outer, "Ptr", outer, "Ptr", inner, "Int", 4)
    DllCall("DeleteObject", "Ptr", inner)
    DllCall("SetWindowRgn", "Ptr", u.frm.Hwnd, "Ptr", outer, "Int", 1)
}

; abre o "recortar tela": arraste pra desenhar, arraste dentro pra mover, puxe bordas/cantos pra ajustar (Enter salva, Esc cancela)
AreaEdit(name, *) {
    global areaOn, areaUi, C_BG, C_TEXT, C_MUTED, areaRes, areaKey
    if areaOn
        return
    hw := FindGameWindow()
    if !(hw && WinGetMinMax(hw) != -1 && DllCall("IsWindowVisible", "Ptr", hw)) {
        if IsObject(areaRes)
            areaRes.Value := TT("area_need_roblox")
        return
    }
    WinGetClientPos(&cx, &cy, &cw, &ch, hw)
    k := A_ScreenDPI / 96
    ar := AreaGet(name, cw, ch)
    u := {name: name, cx: cx, cy: cy, cw: cw, ch: ch, mode: "", was: false, ax: 0, ay: 0, ox: 0, oy: 0, fl: [0, 0]}
    u.x := cx + Round(ar[1] * cw), u.y := cy + Round(ar[2] * ch)
    u.w := Max(Round(20 * k), Round(ar[3] * cw)), u.h := Max(Round(16 * k), Round(ar[4] * ch))
    u.ov := Gui("-Caption +AlwaysOnTop +ToolWindow -DPIScale +E0x08000000")
    u.ov.BackColor := "000000"
    u.ov.Show(Format("NA x{} y{} w{} h{}", cx, cy, cw, ch))
    WinSetTransparent(120, u.ov.Hwnd)
    u.fill := Gui("-Caption +AlwaysOnTop +ToolWindow -DPIScale +E0x20 +E0x08000000")
    u.fill.BackColor := "5B8CFF"
    u.fill.Show(Format("NA x{} y{} w{} h{}", u.x, u.y, u.w, u.h))
    WinSetTransparent(90, u.fill.Hwnd)
    u.frm := Gui("-Caption +AlwaysOnTop +ToolWindow -DPIScale +E0x20 +E0x08000000")
    u.frm.BackColor := "FFFFFF"
    u.frm.Show(Format("NA x{} y{} w{} h{}", u.x, u.y, u.w, u.h))
    u.tb := Gui("-Caption +AlwaysOnTop +ToolWindow -DPIScale +Border")
    u.tb.BackColor := C_BG
    u.tb.MarginX := 0, u.tb.MarginY := 0
    FontUI(u.tb, "s10 w700")
    tbw := Round(520 * k)
    u.tb.Add("Text", Format("x{} y{} w{} h{} c{} Background{}", Round(12 * k), Round(8 * k), tbw - Round(24 * k), Round(22 * k), C_TEXT, C_BG)
        , TT("area_tb_title", TT(areaKey[name])))
    FontUI(u.tb, "s8")
    u.tb.Add("Text", Format("x{} y{} w{} h{} c{} Background{}", Round(12 * k), Round(30 * k), tbw - Round(24 * k), Round(18 * k), C_MUTED, C_BG), TT("area_tb_hint"))
    FontUI(u.tb, "s9")
    b1 := u.tb.Add("Button", Format("x{} y{} w{} h{} Default", tbw - Round(300 * k), Round(54 * k), Round(90 * k), Round(30 * k)), TT("area_save"))
    b2 := u.tb.Add("Button", Format("x{} y{} w{} h{}", tbw - Round(204 * k), Round(54 * k), Round(90 * k), Round(30 * k)), TT("btn_area_def"))
    b3 := u.tb.Add("Button", Format("x{} y{} w{} h{}", tbw - Round(108 * k), Round(54 * k), Round(96 * k), Round(30 * k)), TT("area_cancel"))
    b1.OnEvent("Click", (*) => AreaSave())
    b2.OnEvent("Click", (*) => AreaDefaults())
    b3.OnEvent("Click", (*) => AreaClose())
    u.tb.Show(Format("NA x{} y{} w{} h{}", cx + (cw - tbw) // 2, cy + Round(10 * k), tbw, Round(94 * k)))
    areaUi := u, areaOn := true
    OnMessage(0x201, AreaTbDrag)
    AreaDraw(u)
    SetTimer(AreaPoll, 15)
}

AreaDefaults() {
    global areaUi, areaDef
    u := areaUi
    d := areaDef[u.name]
    u.x := u.cx + Round(d[1] * u.cw), u.y := u.cy + Round(d[2] * u.ch)
    u.w := Round(d[3] * u.cw), u.h := Round(d[4] * u.ch)
    AreaDraw(u)
}

AreaPoll() {
    global areaOn, areaUi
    if (!areaOn || !IsObject(areaUi)) {
        SetTimer(AreaPoll, 0)
        return
    }
    u := areaUi
    static tk := 0
    if (Mod(++tk, 8) = 0) {                 ; mantém a barra de botões sempre por cima da sombra
        for w in [u.fill, u.frm, u.tb]
            DllCall("SetWindowPos", "Ptr", w.Hwnd, "Ptr", -1, "Int", 0, "Int", 0, "Int", 0, "Int", 0, "UInt", 0x13)
    }
    pt := Buffer(8, 0)
    DllCall("GetCursorPos", "Ptr", pt)
    mx := NumGet(pt, 0, "Int"), my := NumGet(pt, 4, "Int")
    down := GetKeyState("LButton", "P")
    k := A_ScreenDPI / 96, hm := Round(9 * k), minW := Round(16 * k)
    mxc := Max(u.cx, Min(u.cx + u.cw, mx)), myc := Max(u.cy, Min(u.cy + u.ch, my))
    if (down && !u.was) {
        u.mode := ""
        WinGetPos(&tx, &ty, &tw, &th, u.tb.Hwnd)
        inTb := (mx >= tx && mx <= tx + tw && my >= ty && my <= ty + th)
        inOv := (mx >= u.cx && mx <= u.cx + u.cw && my >= u.cy && my <= u.cy + u.ch)
        if (!inTb && inOv) {
            x1 := u.x, y1 := u.y, x2 := u.x + u.w, y2 := u.y + u.h
            nL := Abs(mx - x1) <= hm, nR := Abs(mx - x2) <= hm, nT := Abs(my - y1) <= hm, nB := Abs(my - y2) <= hm
            inX := (mx >= x1 - hm && mx <= x2 + hm), inY := (my >= y1 - hm && my <= y2 + hm)
            if (inX && inY && (nL || nR || nT || nB)) {
                u.mode := "resize"
                u.fl := [nL ? 1 : (nR ? 2 : 0), nT ? 1 : (nB ? 2 : 0)]
            } else if (mx > x1 && mx < x2 && my > y1 && my < y2) {
                u.mode := "move", u.ox := mx - u.x, u.oy := my - u.y
            } else
                u.mode := "new", u.ax := mxc, u.ay := myc
        }
    }
    if (down && u.mode != "") {
        if (u.mode = "move") {
            u.x := Max(u.cx, Min(u.cx + u.cw - u.w, mx - u.ox))
            u.y := Max(u.cy, Min(u.cy + u.ch - u.h, my - u.oy))
        } else if (u.mode = "new") {
            u.x := Min(u.ax, mxc), u.y := Min(u.ay, myc)
            u.w := Max(minW, Abs(mxc - u.ax)), u.h := Max(minW, Abs(myc - u.ay))
            u.w := Min(u.w, u.cx + u.cw - u.x), u.h := Min(u.h, u.cy + u.ch - u.y)
        } else {
            x1 := u.x, y1 := u.y, x2 := u.x + u.w, y2 := u.y + u.h
            if (u.fl[1] = 1)
                x1 := Min(mxc, x2 - minW)
            else if (u.fl[1] = 2)
                x2 := Max(mxc, x1 + minW)
            if (u.fl[2] = 1)
                y1 := Min(myc, y2 - minW)
            else if (u.fl[2] = 2)
                y2 := Max(myc, y1 + minW)
            u.x := x1, u.y := y1, u.w := x2 - x1, u.h := y2 - y1
        }
        AreaDraw(u)
    }
    if !down
        u.mode := ""
    u.was := down
}

; arrastar a barra de botões: clique e segure em qualquer parte dela que não seja botão
AreaTbDrag(wParam, lParam, msg, hwnd) {
    global areaOn, areaUi
    if (!areaOn || !IsObject(areaUi))
        return
    root := DllCall("GetAncestor", "Ptr", hwnd, "UInt", 2, "Ptr")
    if (root != areaUi.tb.Hwnd)
        return
    try cls := WinGetClass("ahk_id " hwnd)
    catch
        return
    if (cls = "Button")
        return
    PostMessage(0xA1, 2, 0, , "ahk_id " areaUi.tb.Hwnd)
    return 0
}

AreaClose() {
    global areaOn, areaUi
    OnMessage(0x201, AreaTbDrag, 0)
    SetTimer(AreaPoll, 0)
    areaOn := false
    if IsObject(areaUi) {
        for w in [areaUi.ov, areaUi.fill, areaUi.frm, areaUi.tb]
            try w.Destroy()
    }
    areaUi := 0
}

AreaSave() {
    global areaOn, areaUi, iniFile
    if (!areaOn || !IsObject(areaUi))
        return
    u := areaUi
    r := [(u.x - u.cx) / u.cw, (u.y - u.cy) / u.ch, u.w / u.cw, u.h / u.ch]
    for i, key in ["x", "y", "w", "h"]
        IniWrite(Round(Max(0, Min(1, r[i])), 4), iniFile, "area", u.name "_" key)
    IniWrite(u.cw, iniFile, "area", u.name "_rw")
    IniWrite(u.ch, iniFile, "area", u.name "_rh")
    AreaClose()
    SetTimer(AreaTest, -300)
}

; lê agora e mostra o resultado na própria aba
; a leitura é da tela: se a janela do programa estiver por cima do Roblox, esconde um instante
ReadUncovered(fn) {
    global g
    hw := FindGameWindow()
    hid := false
    try {
        if (hw && DllCall("IsWindowVisible", "Ptr", g.Hwnd)) {
            WinGetPos(&gx, &gy, &gw, &gh, g.Hwnd)
            WinGetClientPos(&rx, &ry, &rw, &rh, hw)
            if (gx < rx + rw && gx + gw > rx && gy < ry + rh && gy + gh > ry) {
                g.Hide()
                hid := true
                Sleep(450)
            }
        }
    }
    try {
        fn()
    } finally {
        if hid
            g.Show("NA")
    }
}

