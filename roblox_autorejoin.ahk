    o := {ctrls: [ic, lb], bg: C_SIDE, hov: C_NAVH, y: y}
    for c in o.ctrls {
        hoverMap[c.Hwnd] := o
        c.OnEvent("Click", (*) => (ClickSnd(), ShowPage(GROUPS[name][1])))
    }
    navs[name] := o
