; texto branco com contorno escuro (o rank da guilda) → imagem grande, preto no branco, que o OCR lê bem.
; Tenta alguns limiares de "branco" e vota; devolve o que o OCR leu (pro log).
GuildPre(hw, ox, oy, ow, oh, votes) {
    global guildTrk
    seen := ""
    guildTrk := 0
    hBM := 0, srcDC := 0
    try {
        rc := Buffer(16, 0)
        DllCall("GetClientRect", "Ptr", hw, "Ptr", rc)
        cw := NumGet(rc, 8, "Int"), chh := NumGet(rc, 12, "Int")
        if (cw < 50 || chh < 50)
            return ""
        ox := Max(0, Min(ox, cw - 8)), oy := Max(0, Min(oy, chh - 8))
        ow := Min(ow, cw - ox), oh := Min(oh, chh - oy)
        hS := DllCall("GetDC", "Ptr", 0, "Ptr")
        srcDC := DllCall("CreateCompatibleDC", "Ptr", hS, "Ptr")
        hBM := DllCall("CreateCompatibleBitmap", "Ptr", hS, "Int", cw, "Int", chh, "Ptr")
        oldS := DllCall("SelectObject", "Ptr", srcDC, "Ptr", hBM, "Ptr")
        ok := DllCall("PrintWindow", "Ptr", hw, "Ptr", srcDC, "UInt", 3)
        if (!ok || IsBlackDC(srcDC, cw, chh)) {
            pt := Buffer(8, 0)
            DllCall("ClientToScreen", "Ptr", hw, "Ptr", pt)
            DllCall("BitBlt", "Ptr", srcDC, "Int", 0, "Int", 0, "Int", cw, "Int", chh
                , "Ptr", hS, "Int", NumGet(pt, 0, "Int"), "Int", NumGet(pt, 4, "Int"), "UInt", 0x00CC0020)
        }
        DllCall("ReleaseDC", "Ptr", 0, "Ptr", hS)
        ; o boneco se mexe e o rank vai junto: acha o ícone verde-água do rank perto da área e lê em cima dele
        rects := []
        for trk in GuildTrack(srcDC, cw, chh, ox, oy, ow, oh) {
            if !IsObject(guildTrk)
                guildTrk := trk
            rects.Push(trk)
            seen .= "[ícone " trk[3] "x" trk[4] " em " trk[1] "," trk[2] "] "
        }
        rects.Push([ox, oy, ow, oh])
        for r in rects {
            seen .= GuildPreRect(srcDC, r[1], r[2], r[3], r[4], votes)
            mx := 0
            for n0, c0 in votes
                mx := Max(mx, c0)
            if (mx >= 5)
                break
        }
    }
    try {
        if srcDC
            DllCall("DeleteDC", "Ptr", srcDC)
        if hBM
            DllCall("DeleteObject", "Ptr", hBM)
    }
    return seen
}

; procura o ícone do rank (a cor muda com o nível da guilda: verde-água, laranja…) numa região em volta da área
; e devolve uma lista de retângulos do número em cima de cada ícone achado (o mais cheio primeiro)
GuildTrack(srcDC, cw, chh, ox, oy, ow, oh) {
    dib := 0, dc := 0
    out := []
    try {
        sw := Round(Min(cw, Max(ow * 5, cw * 0.25))), sh := Round(Min(chh, Max(oh * 8, chh * 0.25)))
        sx := Max(0, Min(cw - sw, Round(ox + ow / 2 - sw / 2))), sy := Max(0, Min(chh - sh, Round(oy + oh / 2 - sh / 2)))
        bmi := Buffer(40, 0)
        NumPut("UInt", 40, "Int", sw, "Int", -sh, "UShort", 1, "UShort", 32, bmi)
        dib := DllCall("CreateDIBSection", "Ptr", 0, "Ptr", bmi, "UInt", 0, "Ptr*", &bits := 0, "Ptr", 0, "UInt", 0, "Ptr")
        dc := DllCall("CreateCompatibleDC", "Ptr", 0, "Ptr")
        DllCall("SelectObject", "Ptr", dc, "Ptr", dib)
        DllCall("BitBlt", "Ptr", dc, "Int", 0, "Int", 0, "Int", sw, "Int", sh, "Ptr", srcDC, "Int", sx, "Int", sy, "UInt", 0x00CC0020)
        DllCall("GdiFlush")
        xs := [[], []], ys := [[], []]            ; 1 = verde-água, 2 = laranja
        y := 0
        while (y < sh) {
            off := y * sw * 4
            Loop sw {
                v := NumGet(bits, off, "UInt")
                rr := (v >> 16) & 255, gg := (v >> 8) & 255, bb := v & 255
                if (rr < 70 && gg > 150 && bb > 110 && gg - rr > 100 && bb <= gg + 8 && gg - bb < 80)
                    xs[1].Push(A_Index - 1), ys[1].Push(y)
                else if (rr > 200 && gg > 55 && gg < 200 && bb < 70 && gg - bb > 30 && rr - bb > 150 && gg < rr - 40)
                    xs[2].Push(A_Index - 1), ys[2].Push(y)
                off += 4
            }
            y += 1
        }
        cand := []
        Loop 2 {
            k := A_Index
            if (xs[k].Length < 20)
                continue
            mxm := 0, mym := 0
            for i, xv in xs[k]
                mxm += xv, mym += ys[k][i]
            mxm /= xs[k].Length, mym /= xs[k].Length
            rad := Max(20, cw * 0.03)
            x0 := 99999, x1 := -1, y0 := 99999, y1 := -1, n := 0
            for i, xv in xs[k] {
                if (Abs(xv - mxm) <= rad && Abs(ys[k][i] - mym) <= rad) {
                    n++
                    x0 := Min(x0, xv), x1 := Max(x1, xv), y0 := Min(y0, ys[k][i]), y1 := Max(y1, ys[k][i])
                }
            }
            iw := x1 - x0 + 1, ih := y1 - y0 + 1
            if (n < 20 || iw < cw * 0.008 || iw > cw * 0.035 || ih < chh * 0.012 || ih > chh * 0.06)
                continue
            cx := sx + (x0 + x1) / 2, cy := sy + (y0 + y1) / 2
            nw := Max(28, Round(iw * 1.9)), nh := Max(12, Round(ih * 0.85))
            nx := Max(0, Min(cw - nw, Round(cx - nw / 2))), ny := Max(0, Min(chh - nh, Round(cy - nh / 2)))
            cand.Push({n: n, r: [nx, ny, nw, nh]})
        }
        if (cand.Length = 2 && cand[2].n > cand[1].n)
            cand := [cand[2], cand[1]]
        for c in cand
            out.Push(c.r)
    } finally {
        if dc
            DllCall("DeleteDC", "Ptr", dc)
        if dib
            DllCall("DeleteObject", "Ptr", dib)
    }
    return out
}

; lê um retângulo do rank: amplia, isola o branco do texto (preto no branco) e vota os números
GuildPreRect(srcDC, ox, oy, ow, oh, votes) {
    seen := ""
    dc := 0, dib := 0
    try {
        ; escala: o texto fica com ~60 px de altura (limite de pixels pra não ficar lento)
        S := 12
        while (S > 2 && (ow * S) * (oh * S) > 260000)
            S -= 1
        P := 24
        W := ow * S, H := oh * S, Wp := W + 2 * P, Hp := H + 2 * P
        bmi := Buffer(40, 0)
        NumPut("UInt", 40, "Int", Wp, "Int", -Hp, "UShort", 1, "UShort", 32, bmi)
        dib := DllCall("CreateDIBSection", "Ptr", 0, "Ptr", bmi, "UInt", 0, "Ptr*", &bits := 0, "Ptr", 0, "UInt", 0, "Ptr")
        dc := DllCall("CreateCompatibleDC", "Ptr", 0, "Ptr")
        oldD := DllCall("SelectObject", "Ptr", dc, "Ptr", dib, "Ptr")
        r2 := Buffer(16, 0), NumPut("Int", Wp, "Int", Hp, r2, 8)
        DllCall("FillRect", "Ptr", dc, "Ptr", r2, "Ptr", DllCall("GetStockObject", "Int", 0, "Ptr"))
        DllCall("SetStretchBltMode", "Ptr", dc, "Int", 4)
        DllCall("StretchBlt", "Ptr", dc, "Int", P, "Int", P, "Int", W, "Int", H
            , "Ptr", srcDC, "Int", ox, "Int", oy, "Int", ow, "Int", oh, "UInt", 0x00CC0020)
        DllCall("GdiFlush")
        orig := Buffer(Wp * Hp * 4)
        DllCall("RtlMoveMemory", "Ptr", orig, "Ptr", bits, "UPtr", Wp * Hp * 4)
        for th in [190, 160, 215] {
            y := 0
            while (y < H) {
                off := ((P + y) * Wp + P) * 4
                Loop W {
                    v := NumGet(orig, off, "UInt")
                    NumPut("UInt", (((v >> 16) & 255) > th && ((v >> 8) & 255) > th && (v & 255) > th) ? 0xFF000000 : 0xFFFFFFFF, bits, off)
                    off += 4
                }
                y += 1
            }
            DllCall("GdiFlush")
            res := ""
            try res := OCR.FromBitmap(dib)
            catch
                continue
            t := SubStr(RegExReplace(res.Text, "\s+", " "), 1, 60)
            if (t != "")
                seen .= (seen = "" ? "" : " | ") "T" th ":" t
            n := ""
            wt := 2
            if RegExMatch(t, "[#＃]\s*([0-9OoIl|SsBZzgq]{1,6})", &m)
                n := FixDigits(m[1]), wt := 3
            else if (RegExMatch(t, "^\W{0,2}[A-Za-z]?\s?(\d{3,6})\W{0,2}$", &m))
                n := m[1]
            if (n != "" && RegExMatch(n, "^[1-9]\d{0,5}$"))
                votes[n] := (votes.Has(n) ? votes[n] : 0) + wt
        }
    }
    try {
        if dc
            DllCall("DeleteDC", "Ptr", dc)
        if dib
            DllCall("DeleteObject", "Ptr", dib)
    }
    return seen
}

; Captura a área, amplia até ~8x e isola o texto claro (modo "white" = só branco; "bright" = claro mas não azul-ciano).
; Devolve uma lista de {text, words:[{t,x}]} (um por limiar), pra quem chamou votar/ordenar.
PreOcr(hw, ox, oy, ow, oh, kind, ths) {
    results := []
    hBM := 0, srcDC := 0, dc := 0, dib := 0
    try {
        rc := Buffer(16, 0)
        DllCall("GetClientRect", "Ptr", hw, "Ptr", rc)
        cw := NumGet(rc, 8, "Int"), chh := NumGet(rc, 12, "Int")
        if (cw < 50 || chh < 50)
            return results
        ox := Max(0, Min(ox, cw - 8)), oy := Max(0, Min(oy, chh - 8))
        ow := Min(ow, cw - ox), oh := Min(oh, chh - oy)
        hS := DllCall("GetDC", "Ptr", 0, "Ptr")
        srcDC := DllCall("CreateCompatibleDC", "Ptr", hS, "Ptr")
        hBM := DllCall("CreateCompatibleBitmap", "Ptr", hS, "Int", cw, "Int", chh, "Ptr")
        DllCall("SelectObject", "Ptr", srcDC, "Ptr", hBM)
        ok := DllCall("PrintWindow", "Ptr", hw, "Ptr", srcDC, "UInt", 3)
        if (!ok || IsBlackDC(srcDC, cw, chh)) {
            pt := Buffer(8, 0)
            DllCall("ClientToScreen", "Ptr", hw, "Ptr", pt)
            DllCall("BitBlt", "Ptr", srcDC, "Int", 0, "Int", 0, "Int", cw, "Int", chh
                , "Ptr", hS, "Int", NumGet(pt, 0, "Int"), "Int", NumGet(pt, 4, "Int"), "UInt", 0x00CC0020)
        }
        DllCall("ReleaseDC", "Ptr", 0, "Ptr", hS)
        sc := 8
        while (sc > 2 && (ow * sc) * (oh * sc) > 260000)
            sc -= 1
        pad := 24
        wd0 := ow * sc, ht0 := oh * sc, Wp := wd0 + 2 * pad, Hp := ht0 + 2 * pad
        bmi := Buffer(40, 0)
        NumPut("UInt", 40, "Int", Wp, "Int", -Hp, "UShort", 1, "UShort", 32, bmi)
        dib := DllCall("CreateDIBSection", "Ptr", 0, "Ptr", bmi, "UInt", 0, "Ptr*", &bits := 0, "Ptr", 0, "UInt", 0, "Ptr")
        dc := DllCall("CreateCompatibleDC", "Ptr", 0, "Ptr")
        DllCall("SelectObject", "Ptr", dc, "Ptr", dib)
        r2 := Buffer(16, 0), NumPut("Int", Wp, "Int", Hp, r2, 8)
        DllCall("FillRect", "Ptr", dc, "Ptr", r2, "Ptr", DllCall("GetStockObject", "Int", 0, "Ptr"))
        DllCall("SetStretchBltMode", "Ptr", dc, "Int", 4)
        DllCall("StretchBlt", "Ptr", dc, "Int", pad, "Int", pad, "Int", wd0, "Int", ht0
            , "Ptr", srcDC, "Int", ox, "Int", oy, "Int", ow, "Int", oh, "UInt", 0x00CC0020)
        DllCall("GdiFlush")
        orig := Buffer(Wp * Hp * 4)
        DllCall("RtlMoveMemory", "Ptr", orig, "Ptr", bits, "UPtr", Wp * Hp * 4)
        for th in ths {
            yy := 0
            while (yy < ht0) {
                off := ((pad + yy) * Wp + pad) * 4
                Loop wd0 {
                    v := NumGet(orig, off, "UInt")
                    r := (v >> 16) & 255, gg := (v >> 8) & 255, b := v & 255
                    if (kind = "white")
                        on := (r > th && gg > th && b > th)
                    else if (kind = "coin")
                        on := ((r * 3 + gg * 6 + b) // 10 > th)
                    else
                        on := ((r * 3 + gg * 6 + b) // 10 > th && b - r < 60)
                    NumPut("UInt", on ? 0xFF000000 : 0xFFFFFFFF, bits, off)
                    off += 4
                }
                yy += 1
            }
            DllCall("GdiFlush")
            res := ""
            try res := OCR.FromBitmap(dib)
            catch
                continue
            words := []
            try for ln in res.Lines
                for w1 in ln.Words
                    words.Push({t: w1.Text, x: w1.x, w: w1.w})
            results.Push({text: res.Text, words: words, sc: sc, pad: pad})
        }
    }
    try {
        if dc
            DllCall("DeleteDC", "Ptr", dc)
        if dib
            DllCall("DeleteObject", "Ptr", dib)
        if srcDC
            DllCall("DeleteDC", "Ptr", srcDC)
        if hBM
            DllCall("DeleteObject", "Ptr", hBM)
    }
    return results
}

; área em pixels, com tamanho mínimo (o OCR do Windows erra em texto muito baixo/estreito): cresce pros dois lados
AreaPx(ar, cw, chh, &ox, &oy, &ow, &oh) {
    ox := Round(cw * ar[1]), oy := Round(chh * ar[2]), ow := Round(cw * ar[3]), oh := Round(chh * ar[4])
    minW := 64, minH := 24
    if (ow < minW)
        ox -= (minW - ow) // 2, ow := minW
    if (oh < minH)
        oy -= (minH - oh) // 2, oh := minH
    ox := Max(0, ox), oy := Max(0, oy)
    ow := Max(24, Min(ow, cw - ox)), oh := Max(16, Min(oh, chh - oy))
}

; corrige letras que o OCR confunde com dígitos (só usado onde se espera número)
FixDigits(t) {
    for pr in [["O", "0"], ["o", "0"], ["I", "1"], ["l", "1"], ["|", "1"], ["S", "5"], ["s", "5"], ["B", "8"], ["Z", "2"], ["z", "2"], ["g", "9"], ["q", "9"]]
        t := StrReplace(t, pr[1], pr[2], true)
    return t
}

; rank da guilda: o número (#123) que fica logo abaixo da foto da guilda, no topo do meio da tela
ReadGuildRank(hw) {
    global farmBest, farmGdbgT, guildSeen
    guildSeen := ""
    static variants := [{mode: 0}, {mode: 4}, {mode: 4, gray: 1}, {mode: 0, gray: 1}]
    try {
        WinGetClientPos(, , &cw, &chh, hw)
        ar := AreaGet("guild", cw, chh)
        AreaPx(ar, cw, chh, &ox, &oy, &ow, &oh)
        lim := OCR.MaxImageDimension ? OCR.MaxImageDimension : 2600
        sc := Max(0.5, Min(6, Floor((lim - 20) / Max(ow, oh) * 10) / 10))
        seen := "", votes := Map(), hashV := Map()
        ; 1) leitura "limpa": amplia a área e isola só o branco do texto (preto no branco) antes do OCR — é o que resolve texto minúsculo
        seen := GuildPre(hw, ox, oy, ow, oh, votes)
        guildSeen := seen
        for n0, c0 in votes
            if (c0 >= 5)
                return n0
        global guildTrk
        if IsObject(guildTrk)
            ox := guildTrk[1], oy := guildTrk[2], ow := guildTrk[3], oh := guildTrk[4]
        sc := Max(0.5, Min(6, Floor((lim - 20) / Max(ow, oh) * 10) / 10))
        ; várias escalas x formas de captura; o número que mais se repete ganha (tira o erro de leitura isolada)
        for sc2 in [sc, Min(sc, 3), Min(sc, 4.5), Min(sc, 2), Min(sc, 6)] {
            Loop 4 {
                v := variants[Mod(farmBest - 1 + A_Index - 1, variants.Length) + 1]
                o := {x: ox, y: oy, w: ow, h: oh, scale: sc2, mode: v.mode}
                if v.HasOwnProp("gray")
                    o.grayscale := 1, o.invertcolors := 1
                res := ""
                try res := OCR.FromWindow("ahk_id " hw, o)
                catch
                    continue
                t := SubStr(RegExReplace(res.Text, "\s+", " "), 1, 80)
                if (t != "" && !InStr(seen, t))
                    seen .= (seen = "" ? "" : " | ") t
                n := ""
                hasHash := false
                if RegExMatch(t, "[#＃]\s*([0-9OoIl|SsBZzgq]{1,6})", &m) {
                    n := FixDigits(m[1]), hasHash := true
                } else if RegExMatch(t, "^\W{0,2}[A-Za-z]?\s?(\d{3,6})\W{0,2}$", &m)
                    n := m[1]
                if (n != "" && RegExMatch(n, "^[1-9]\d{0,5}$")) {
                    votes[n] := (votes.Has(n) ? votes[n] : 0) + (hasHash ? 2 : 1)
                    if (votes[n] >= 4)
                        return n
                }
            }
        }
        best := "", bv := 0
        for n, c in votes
            if (c > bv)
                best := n, bv := c
        guildSeen := seen
        if (best != "")
            return best
        if (A_TickCount - farmGdbgT > 120000) {
            farmGdbgT := A_TickCount
            Log("Guilda · não achei o #rank. Área " ow "x" oh " em " ox "," oy " (janela " cw "x" chh "). Leu: [" SubStr(seen, 1, 200) "]")
        }
    }
    return ""
}

; lê (só olhando a tela) o nome do modo/mapa, o contador de pearls e as cores deles, em cima da vida da base
; rank da guilda: só troca o valor quando a mesma leitura aparece 2 vezes seguidas (evita erro de OCR)
GuildTick(hw) {
    global farmGuild, chkHudGd, chkGuildSend, chkGuildNotify, chkGuildStat
    static pend := "", cnt := 0
    if !(chkHudGd.Value || chkGuildSend.Value || chkGuildNotify.Value || chkGuildStat.Value)
        return
    gr := ReadGuildRank(hw)
    if AdvOn() {
        global guildSeen
        LogA("Rank · " (gr != "" ? "leu #" gr : "não achou o número") " (contagem " cnt "/" IniRead(iniFile, "cfg", "guildN", "3") ") · " SubStr(guildSeen, 1, 110))
    }
    if (gr = "") {                        ; não achou: zera a contagem (as leituras precisam ser SEGUIDAS)
        pend := "", cnt := 0
        return
    }
    if (gr = farmGuild) {                 ; já confirmado
        pend := "", cnt := 0
        return
    }
    if (farmGuild != "" && StrLen(gr) < StrLen(farmGuild) - 1) {   ; ex.: #9897 -> "#5": é ruído do OCR
        pend := "", cnt := 0
        return
    }
    ; só mostra um rank novo depois de N leituras IGUAIS SEGUIDAS (N = ini [cfg] guildN, padrão 3);
    ; se uma leitura falhar ou vier um número diferente, recomeça do zero
    need := 3
    try need := Max(1, Min(10, Integer(IniRead(iniFile, "cfg", "guildN", "3"))))
    if (gr = pend)
        cnt++
    else
        pend := gr, cnt := 1
    if (cnt >= need) {
        old := farmGuild
        farmGuild := gr, pend := "", cnt := 0
        GuildChanged(old, gr)
    }
}

; OCR de uma área escolhida pelo usuário; tenta jeitos de captura até o teste "ok" passar
OcrAreaRead(hw, name, ok) {
    global farmBest
    static variants := [{mode: 0}, {mode: 4}, {mode: 4, gray: 1}, {mode: 0, gray: 1}]
    out := {res: 0, text: "", vi: 0, ok: false, err: ""}
    try {
        WinGetClientPos(, , &cw, &chh, hw)
        ar := AreaGet(name, cw, chh)
        AreaPx(ar, cw, chh, &ox, &oy, &ow, &oh)
        lim := OCR.MaxImageDimension ? OCR.MaxImageDimension : 2600
        sc := Max(0.5, Min(6, Floor((lim - 20) / Max(ow, oh) * 10) / 10))
        Loop variants.Length {
            vi := Mod(farmBest - 1 + A_Index - 1, variants.Length) + 1
            v := variants[vi]
            o := {x: ox, y: oy, w: ow, h: oh, scale: sc, mode: v.mode}
            if v.HasOwnProp("gray")
                o.grayscale := 1, o.invertcolors := 1
            res := ""
            try res := OCR.FromWindow("ahk_id " hw, o)
            catch as e1 {
                out.err := e1.Message
                continue
            }
            out.res := res, out.vi := vi
            out.text := Trim(RegExReplace(res.Text, "\s+", " "))
            if ok(out.text) {
                out.ok := true
                break
            }
        }
    } catch as e {
        out.err := e.Message
    }
    return out
}

; lê (só olhando a tela) o nome do modo, a wave e as pearls, cada um na sua área, e as cores deles
; Agenda das leituras (modo, wave, pérolas, guilda) numa passada só.
; ini [cfg] ocrSec = intervalo em segundos (padrão 15, mínimo 2). O ciclo
; nunca se sobrepõe e se adapta: se a leitura demorou, espera ~4x o tempo gasto.
OcrLoop() {
    static busy := false, nextAt := A_TickCount + 5000
    if (busy || A_TickCount < nextAt)
        return
    busy := true
    t0 := A_TickCount
    try FarmModeTick()
    busy := false
    global farmMiss
    sec := Max(2, Integer(IniRead(iniFile, "cfg", "ocrSec", "15")))
    global farmGuild, chkHudGd
    if (farmMiss > 0 && farmMiss < 6)               ; ainda não achou: tenta de novo logo
        sec := Min(sec, 4)
    else if (chkHudGd.Value && farmGuild = "")      ; rank da guilda ainda sem as 3 leituras iguais
        sec := Min(sec, 5)
    nextAt := A_TickCount + Max(sec * 1000, (A_TickCount - t0) * 4)
    LogA("OCR · próxima leitura em " Round((nextAt - A_TickCount) / 1000) " s")
}

FarmModeTick(test := false) {
    global aaMode, farmLast, farmMode, farmWave, farmMiss, hudMode, chkPanel, farmPearls, farmPrev, farmModeCol, farmPearlCol, farmBest, farmGuild, chkHudGd, chkGuildSend, chkGuildNotify, chkGuildStat
    if !aaMode
        return
    farmLast := {mode: "", wave: "", pearls: "", seen: ""}
    tA := A_TickCount
    hw := FindGameWindow()
    if !(hw && WinGetMinMax(hw) != -1 && DllCall("IsWindowVisible", "Ptr", hw)) {
        farmMode := "", farmWave := ""
        return
    }
    GuildTick(hw)
    mode := "", wave := "", pearls := "", mRect := 0, pRect := 0, seen := ""
    ; --- modo (nome do mapa) ---
    r := OcrAreaRead(hw, "mode", (t) => RegExMatch(t, "[A-Za-z]{4}") && !RegExMatch(t, "\d{3,}\s*/\s*\d{3,}"))
    seen := r.text
    if (r.ok) {
        farmBest := r.vi
        for line in r.res.Lines {
            t := Trim(RegExReplace(line.Text, "\s+", " "))
            if (RegExMatch(t, "[A-Za-z]{4}") && !RegExMatch(t, "\d{3,}\s*/\s*\d{3,}") && !RegExMatch(t, "i)^wave\b")) {
                mode := ModeClean(t)
                mRect := LineRect(line)
                break
            }
        }
    }
    ; --- wave ---
    r := OcrAreaRead(hw, "wave", (t) => RegExMatch(t, "\d"))
    if (r.text != "")
        seen .= " | " r.text
    if r.ok {
        if RegExMatch(r.text, "i)wave\s*([0-9OolI]{1,4})", &m)
            wave := m[1]
        else if RegExMatch(r.text, "([0-9OolI]{1,4})\s*$", &m)
            wave := m[1]
        wave := StrReplace(StrReplace(StrReplace(StrReplace(wave, "O", "0"), "o", "0"), "l", "1"), "I", "1")
    }
    ; --- pearls ---
    r := OcrAreaRead(hw, "pearls", (t) => RegExMatch(t, "\d"))
    if (r.text != "")
        seen .= " | " r.text
    if r.ok {
        for line in r.res.Lines {
            t := Trim(RegExReplace(line.Text, "\s+", " "))
            if RegExMatch(t, "\+?\s*(\d[\d.,]*[kKmMbB]?)", &pm) {
                pearls := pm[1], pRect := LineRect(line)
                for wd in line.Words
                    if InStr(wd.Text, pm[1]) {
                        pRect := [wd.x, wd.y, wd.w, wd.h]
                        break
                    }
                break
            }
        }
    }
    farmLast := {mode: mode, wave: wave, pearls: pearls, seen: SubStr(seen, 1, 140)}
    if AdvOn()
        AdvReport(hw, mode, wave, pearls, seen, A_TickCount - tA)
    if (mode = "" && wave = "" && pearls = "") {
        FarmDbg("não achei nada nas áreas de leitura. Leu: [" SubStr(seen, 1, 110) "]")
        if (++farmMiss >= 3)
            farmMode := "", farmWave := ""
        return
    }
    if (mode = "")
        FarmDbg("não li o nome do modo. Leu: [" SubStr(seen, 1, 110) "]")
    if (mode != "") {
        mode := SubStr(mode, 1, 50)
        if (farmPearls != "" && (mode != farmMode || (pearls != "" && ParseNum(pearls) != "" && ParseNum(farmPearls) != "" && ParseNum(pearls) < ParseNum(farmPearls) * 0.5)))
            farmPrev := farmPearls
        farmMode := mode
        if IsObject(mRect) {
            cc := SampleTextColor(hw, mRect[1], mRect[2], mRect[3], mRect[4])
            if (cc != "")
                farmModeCol := cc
        }
    }
    if (pearls != "") {
        farmPearls := pearls
        if IsObject(pRect) {
            cc := SampleTextColor(hw, pRect[1], pRect[2], pRect[3], pRect[4])
            if (cc != "")
                farmPearlCol := cc
        }
    }
    farmWave := wave != "" ? wave : farmWave, farmMiss := 0
}

; limpa o texto do nome do modo: tira acento/bolinhas/lixo e corrige pelo nome mais parecido já visto (ini [modes])
ModeClean(t) {
    t := RegExReplace(t, "\)(?=[A-Za-z])", ") ")
    for a, b in Map("á","a","à","a","â","a","ã","a","é","e","ê","e","í","i","ó","o","ô","o","õ","o","ú","u","ç","c")
        t := StrReplace(t, a, b)
    t := Trim(RegExReplace(RegExReplace(t, "[•·|_~\[\]{}<>=]", " "), "\s+", " "))
    t := RegExReplace(t, "(?<=[a-z])(?=[A-Z][a-z])", " ")          ; "RainVillage" -> "Rain Village"
    t := RegExReplace(t, "(?<=[A-Za-z])\d+(?=[A-Za-z])", "")        ; dígito no meio de palavra é ruído
    best := "", bs := 0.72, lc := StrLower(RegExReplace(t, "[^A-Za-z]"))
    known := IniRead(iniFile, "modes", "list", "Rain Village Infinite Mode|Infinite Mode")
    for nm in StrSplit(known, "|") {
        nl := StrLower(RegExReplace(nm, "[^A-Za-z]"))
        if (nl = "" || lc = "")
            continue
        sc := 1 - EditDist(lc, nl) / Max(StrLen(lc), StrLen(nl))
        if (sc > bs)
            bs := sc, best := nm
    }
    return best != "" ? best : t
}

EditDist(a, b) {
    la := StrLen(a), lb := StrLen(b)
    prev := [], cur := []
    Loop lb + 1
        prev.Push(A_Index - 1)
    Loop la {
        i := A_Index, cur := [i]
        Loop lb {
            j := A_Index
            cur.Push(Min(prev[j + 1] + 1, cur[j] + 1, prev[j] + (SubStr(a, i, 1) = SubStr(b, j, 1) ? 0 : 1)))
        }
        prev := cur
    }
    return prev[lb + 1]
}

PanelTick() {
    global chkPanel, edPanelMin, panelLast
    if !chkPanel.Value
        return
    secs := Max(5, Integer(Trim(edPanelMin.Value) || 15))
    if (A_TickCount - panelLast >= secs * 1000 - 1000)
        PanelUpdate()
}

PanelUpdate(force := false) {
    global chkPanel, chkBot, edToken, edChan, panelMsg, panelLast, iniFile, running, monStart, launches, discCount
    global lastDiscUnix, discTick, dayOnline, chkOcr, APP_NAME, USER_NAME, LOGO_URL, VERSION, curState, prevCur
    global botBad, edHook, panelVia, farmMode, farmWave, farmPearls, farmPrev, farmGuild, edLink, aaMode
    if !chkPanel.Value {
        if force
            Log("Painel · ligue o toggle 'Painel fixo no canal'")
        return
    }
    tok := TokClean(), ch := Trim(edChan.Value), hook := RegExReplace(Trim(edHook.Value), "\?.*$")
    useBot := chkBot.Value && tok != "" && ch != "" && !botBad
    if (!useBot && hook = "") {
        if force
            Log("Painel · configure o Bot (token + canal) ou o link do Webhook")
        return
    }
    via := useBot ? "bot" : "hook"
    if (via != panelVia) {                    ; trocou de bot pra webhook (ou o contrário): recria a mensagem
        panelMsg := "", panelVia := via
        IniWrite(via, iniFile, "cfg", "panelVia")
    }
    if (!force && A_TickCount - panelLast < 4000)
        return
    if force
        Log("Painel · montando embed…")
    panelLast := A_TickCount

    try {
    open := IsRobloxOpen()
    if !open
        title := "🔴  Offline", color := 0xFF5C5C
    else if discTick
        title := "🟡  " TT("emb_warn"), color := 0xF5C542
    else
        title := "🟢  " TT("emb_online"), color := 0x3DDC84
    if !running
        title .= "  ·  " TT("up_stopped"), color := 0x8B8B94

    ; painel leve: usa as moedas já lidas (prevCur) e dados rápidos — nada de OCR/WMI que trava
    shot := ""
    esc := Chr(27)
    coinsBlk := ""
    for c in CurrencySpec() {
        if !(aaMode && prevCur.Has(c.name) && prevCur[c.name] != "")
            continue
        nm := StrLower(c.name)
        col := InStr(nm, "gem") && !InStr(nm, "legacy") ? "36" : (InStr(nm, "gold") || InStr(nm, "coin")) ? "33" : InStr(nm, "pearl") ? "35" : InStr(nm, "legacy") ? "34" : "37"
        lbl := SubStr(c.name "              ", 1, 16)
        val := FmtNum(prevCur[c.name])
        coinsBlk .= esc "[" col "m" lbl esc "[0m" esc "[1;37m" SubStr("            " val, -11) esc "[0m`n"
    }
    DayRoll()
    ms := Buffer(64, 0), NumPut("UInt", 64, ms), DllCall("GlobalMemoryStatusEx", "Ptr", ms)
    cpu := CpuLoad(), ramPct := NumGet(ms, 4, "UInt")
    now := DateDiff(A_NowUTC, "19700101000000", "Seconds")
    fence := "``````"
    desc := "# " title "`n-# ⏱ " AfkStr() "  ·  🔄 " TT("d_updated") " <t:" now ":R>`n"
    if (farmMode != "") {
        desc .= "`n### 🗺  Farm`n> **" farmMode "**" (farmWave != "" ? "  ·  Wave **" farmWave "**" : "")
        if (farmPearls != "")
            desc .= "`n> 🫧 **+" farmPearls "**"
        desc .= "`n"
    }
    if (coinsBlk != "")
        desc .= "`n### 💰  " TT("nav_coins") "`n" fence "ansi`n" coinsBlk fence "`n"
    cpuC := cpu >= 85 ? "31" : cpu >= 60 ? "33" : "32"
    ramC := ramPct >= 90 ? "31" : ramPct >= 75 ? "33" : "32"
    sysBlk := esc "[1;37mCPU" esc "[0m  " esc "[" cpuC "m" PBar(cpu) esc "[0m " SubStr("  " cpu, -2) "%`n"
        . esc "[1;37mRAM" esc "[0m  " esc "[" ramC "m" PBar(ramPct) esc "[0m " SubStr("  " ramPct, -2) "%`n"
    desc .= "`n### 🖥  PC`n" fence "ansi`n" sysBlk fence
    lk := Trim(edLink.Value)
    if (SubStr(lk, 1, 4) = "http" && !InStr(lk, " "))
        desc .= "`n[🎮 " TT("f_link") "](" lk ")"
    fields := []
    if (aaMode && farmGuild != "" && chkGuildSend.Value)
        fields.Push(["🛡 " TT("f_guild"), "#" farmGuild, true])
    if (farmPrev != "")
        fields.Push(["⏮ " TT("f_prevround"), "+" farmPrev, true])
    for f in [["📅 " TT("f_online_today"), "**" DurStr(dayOnline * 1000) "**", true]
        , ["♻ " TT("f_reopens"), "**" launches "**", true], ["⚠ " TT("f_drops"), "**" discCount "**", true]
        , ["🕓 " TT("f_lastdrop"), lastDiscUnix ? "<t:" lastDiscUnix ":R>" : "*" TT("none") "*", true]]
        fields.Push(f)
    ts := FormatTime(A_NowUTC, "yyyy-MM-dd") "T" FormatTime(A_NowUTC, "HH:mm:ss") "Z"
    pbody := '"embeds":[{'
        . '"author":{"name":"' JsonEsc(APP_NAME "  ·  " TT("ev_panel")) '","icon_url":"' LOGO_URL '"},'
        . '"color":' color ','
        . '"description":"' JsonEsc(desc) '",' FieldsJson(fields)
        . '"thumbnail":{"url":"' LOGO_URL '"},'
        . (shot != "" ? '"image":{"url":"attachment://roblox.png"},' : '')
        . '"footer":{"text":"' JsonEsc(USER_NAME "  •  " A_ComputerName "  •  v" VERSION) '","icon_url":"' LOGO_URL '"},'
        . '"timestamp":"' ts '"}],'
        . '"attachments":' (shot != "" ? '[{"id":0,"filename":"roblox.png"}]' : '[]') '}'
    payload := '{"allowed_mentions":{"parse":[]},' pbody
    base := "https://discord.com/api/v10/channels/" ch "/messages"
    if force
        Log("Painel · enviando ao Discord…")
    if !useBot {
        payloadC := '{"username":"Auto Reconnect","avatar_url":"' LOGO_URL '","allowed_mentions":{"parse":[]},' pbody
        try {
            if (panelMsg != "")
                AsyncReq("PATCH", hook "/messages/" panelMsg, payload, "application/json", "", PanelPatchedH.Bind(hook, payloadC))
            else
                AsyncReq("POST", hook "?wait=true", payloadC, "application/json", "", PanelCreatedH)
        } catch as e
            Log("Painel · " TT("hook_fail", e.Message))
        return
    }
    try {
        if (panelMsg != "")
            AsyncReq("PATCH", base "/" panelMsg, payload, "application/json", "Bot " tok, PanelPatched.Bind(base, payload, "", tok, ch))
        else
            PanelCreate(base, payload, "", tok, ch)
    } catch as e
        Log("Painel · " TT("hook_fail", e.Message))
    } catch as e2
        Log("Painel · ERRO montando: " e2.Message " [linha " e2.Line "]")
}

PanelPatchedH(hook, payloadC, http) {
    global panelMsg
    st := HttpStatus(http)
    if (st >= 200 && st < 300)
        return
    panelMsg := ""
    Log("Painel · " TT("hook_fail", "edit HTTP " st " → recriando"))
    AsyncReq("POST", hook "?wait=true", payloadC, "application/json", "", PanelCreatedH)
}

PanelCreatedH(http) {
    global panelMsg, iniFile
    st := HttpStatus(http)
    if (st < 200 || st >= 300) {
        rt := ""
        try rt := http.ResponseText
        Log("Painel · " TT("hook_fail", "HTTP " st "  " SubStr(rt, 1, 150)))
        return
    }
    try {
        panelMsg := JsonPick(http.ResponseText, "a.id")
        IniWrite(panelMsg, iniFile, "cfg", "panelMsg")
        Log("Painel · " TT("hook_sent", st))
    }
}

PanelPatched(base, payload, shot, tok, ch, http) {
    global panelMsg
    st := HttpStatus(http)
    if (st >= 200 && st < 300)
        return
    panelMsg := ""                            ; qualquer falha (apagada/antiga): recria do zero
    Log("Painel · " TT("hook_fail", "edit HTTP " st " → recriando"))
    PanelCreate(base, payload, shot, tok, ch)
}

PanelCreate(base, payload, shot, tok, ch) {
    AsyncReq("POST", base, payload, "application/json", "Bot " tok, PanelCreated.Bind(tok, ch))
}

PanelCreated(tok, ch, http) {
    global panelMsg, iniFile, reactReady
    st := HttpStatus(http)
    if (st < 200 || st >= 300) {
        rt := ""
        try rt := http.ResponseText
        Log("Painel · " TT("hook_fail", "HTTP " st "  " SubStr(rt, 1, 150)))
        return
    }
    try {
        panelMsg := JsonPick(http.ResponseText, "a.id")
        IniWrite(panelMsg, iniFile, "cfg", "panelMsg")
        IniWrite("bot", iniFile, "cfg", "panelVia")
        reactReady := false
        AsyncReq("PUT", "https://discord.com/api/v10/channels/" ch "/pins/" panelMsg, "", "", "Bot " tok)
        Log("Painel · " TT("hook_sent", st))
    }
}

; ==========================================================
;  HUD grudado na janela do Roblox (barra embaixo ou painel no canto) + moldura de status
;  Fica "dono" da janela do Roblox: anda junto, some quando ela minimiza e não fica por cima de outros apps.
; ==========================================================
HudToggleUser(*) {
    global hudUserHidden
    hudUserHidden := !hudUserHidden
    HudTick(true)
}

HudModeName(m) {
    return TT("hud_mode") ": " TT(["hud_off", "hud_bar", "hud_overlay", "hud_side", "hud_panel"][m + 1])
}

HudRelayout() {
    global hudPnlKey
    hudPnlKey := ""
    HudTick(true)
}

SetHudMode(m, *) {
    global hudMode, hudBtns
    hudMode := m
    if (m = 4)
        SetTimer(() => FarmModeTick(), -400)
    for i, bt in hudBtns
        SetBtnStyle(bt, (i - 1 = m) ? "primary" : "sec")
    HudApply()
}

HudBuild() {
    global hudBar, hudBarDot, hudBarL, hudBarR, hudPan, hudPanDot, hudPanT, hudPanL, hudFrame, hudSide, hudSideDot, hudSideT, hudSideL, C_CARD, C_TEXT, C_MUTED, C_DIM
    k := A_ScreenDPI / 96
    ; barra (clicável: abre o programa)
    hudBar := Gui("-Caption +ToolWindow -DPIScale +E0x08000000")
    hudBar.BackColor := C_CARD
    hudBar.MarginX := 0, hudBar.MarginY := 0
    FontUI(hudBar, "s" Round(9) " w700")
    hudBarDot := hudBar.Add("Text", Format("x{} y0 w{} h{} +0x200 c{} Background{}", Round(10 * k), Round(16 * k), Round(28 * k), C_DIM, C_CARD), "●")
    FontUI(hudBar, "s9")
    hudBarL := hudBar.Add("Text", Format("x{} y0 w{} h{} +0x200 c{} Background{}", Round(28 * k), Round(600 * k), Round(28 * k), C_TEXT, C_CARD), "")
    hudBarR := hudBar.Add("Text", Format("x0 y0 w{} h{} +0x200 Right c{} Background{}", Round(150 * k), Round(28 * k), C_MUTED, C_CARD), "")
    for c in [hudBarDot, hudBarL, hudBarR]
        c.OnEvent("Click", (*) => ShowMain())
    ; painel no canto (clique passa direto pro jogo)
    hudPan := Gui("-Caption +ToolWindow -DPIScale +E0x08000000 +E0x20")
    hudPan.BackColor := C_CARD
    hudPan.MarginX := 0, hudPan.MarginY := 0
    FontUI(hudPan, "s10")
    hudPanDot := hudPan.Add("Text", Format("x{} y{} w{} c{} Background{}", Round(12 * k), Round(8 * k), Round(16 * k), C_DIM, C_CARD), "●")
    FontUI(hudPan, "s10 w700")
    hudPanT := hudPan.Add("Text", Format("x{} y{} w{} c{} Background{}", Round(30 * k), Round(8 * k), Round(200 * k), C_TEXT, C_CARD), "")
    FontUI(hudPan, "s8")
    hudPanL := hudPan.Add("Text", Format("x{} y{} w{} h{} c{} Background{}", Round(12 * k), Round(30 * k), Round(220 * k), Round(62 * k), C_MUTED, C_CARD), "")
    ; painel lateral direito (clicável: abre o programa) com stats completos
    hudSide := Gui("-Caption +ToolWindow -DPIScale +E0x08000000")
    hudSide.BackColor := C_CARD
    hudSide.MarginX := 0, hudSide.MarginY := 0
    FontUI(hudSide, "s9 w700")
    hudSideDot := hudSide.Add("Text", Format("x{} y{} w{} c{} Background{}", Round(14 * k), Round(12 * k), Round(16 * k), C_DIM, C_CARD), "●")
    hudSideT := hudSide.Add("Text", Format("x{} y{} w{} c{} Background{}", Round(32 * k), Round(12 * k), Round(188 * k), C_TEXT, C_CARD), "")
    FontUI(hudSide, "s9")
    hudSideL := hudSide.Add("Text", Format("x{} y{} w{} h{} c{} Background{}", Round(14 * k), Round(42 * k), Round(210 * k), Round(270 * k), C_MUTED, C_CARD), "")
    for c in [hudSideDot, hudSideT, hudSideL]
        c.OnEvent("Click", (*) => ShowMain())
    ; moldura
    hudFrame := Gui("-Caption +ToolWindow -DPIScale +E0x08000000 +E0x20")
    hudFrame.BackColor := C_DIM
    HudBuildPanel()
}

; painel de farm: fica do lado esquerdo do Roblox (Status, Modo de farm, Moedas e Logs)
HudBuildPanel() {
    global hudPnl, hudPnlW, hudPnlLogN, VERSION, C_BG, C_CARD, C_TEXT, C_MUTED, C_DIM, C_ACC, C_NAVA
    hudPnlLogN := 6
    hudPnl := Gui("-Caption +ToolWindow -DPIScale +E0x08000000")
    hudPnl.BackColor := C_BG
    hudPnl.MarginX := 0, hudPnl.MarginY := 0
    hudPnlW := Map()
    AddT := (nm, fnt, fg, bg, opt, txt := "") => (FontUI(hudPnl, fnt), hudPnlW[nm] := hudPnl.Add("Text", "x0 y0 w10 h10 +0x100 " opt " c" fg " Background" bg, txt))
    AddT("title", "s10 w700", C_TEXT, C_BG, "+0x200", "Auto Reconnect")
    AddT("dot", "s10", C_DIM, C_BG, "+0x200 Right", "●")
    AddT("hello", "s8", C_MUTED, C_BG, "+0x200")
    for n in ["st", "md", "wv", "gd", "co", "lg"] {
        hudPnlW[n "F"] := hudPnl.Add("Text", "x0 y0 w10 h10 +0x100 Background" C_NAVA)
        hudPnlW[n "I"] := hudPnl.Add("Text", "x0 y0 w10 h10 +0x100 Background" C_CARD)
    }
    AddT("stT", "s9 w700", C_TEXT, C_CARD, "+0x200")
    AddT("stS", "s8", C_MUTED, C_CARD, "+0x200")
    AddT("mdN", "s10 w700", C_TEXT, C_CARD, "")
    AddT("wvT", "s14 w700", C_TEXT, C_CARD, "+0x200")
    AddT("gdT", "s14 w700", C_TEXT, C_CARD, "+0x200")
    AddT("mdP", "s14 w700", C_TEXT, C_CARD, "+0x200")
    AddT("mdA", "s8", C_DIM, C_CARD, "+0x200")
    AddT("coT", "s8", C_TEXT, C_CARD, "")
    AddT("lgT", "s8", C_MUTED, C_CARD, "")
    for n, ky in Map("st", "hud_box_status", "md", "f_mode", "wv", "area_wave", "gd", "f_guild", "co", "nav_coins", "lg", "nav_logs")
        AddT(n "H", "s7 w700", C_ACC, C_BG, "+0x200 Center", StrUpper(TT(ky)))
    AddT("role", "s8", C_DIM, C_BG, "+0x200", "BETA  ·  v" VERSION)
    AddT("upd", "s8 w700", C_BG, C_ACC, "+0x200 Center", TT("hud_newupd"))
    hudPnlW["upd"].Visible := false
    for n, c in hudPnlW
        c.OnEvent("Click", (*) => ShowMain())
}

HudBox(n, x, y, w, h, k) {
    global hudPnlW
    hudPnlW[n "F"].Move(x, y, w, h)
    hudPnlW[n "I"].Move(x + 1, y + 1, w - 2, h - 2)
    RoundCtrl(hudPnlW[n "F"], 10)
    RoundCtrl(hudPnlW[n "I"], 9)
    tw := Round(90 * k)
    hudPnlW[n "H"].Move(x + Round(12 * k), y - Round(8 * k), tw, Round(16 * k))
}

HudPanelLayout(pw, ph, k) {
    global hudPnlW, hudPnlLogN, chkHudSt, chkHudMd, chkHudCo, chkHudLg, chkHudWv, chkHudGd
    m := Round(10 * k), bw := pw - 2 * m, pad := Round(12 * k), tw := bw - 2 * pad
    hudPnlW["title"].Move(Round(14 * k), Round(11 * k), pw - Round(60 * k), Round(20 * k))
    hudPnlW["dot"].Move(pw - Round(40 * k), Round(11 * k), Round(26 * k), Round(20 * k))
    hudPnlW["hello"].Move(Round(14 * k), Round(31 * k), pw - Round(28 * k), Round(16 * k))
    cards := Map("st", [chkHudSt.Value, ["stT", "stS"]], "md", [chkHudMd.Value, ["mdN", "mdP", "mdA"]], "wv", [chkHudWv.Value, ["wvT"]], "gd", [chkHudGd.Value, ["gdT"]]
        , "co", [chkHudCo.Value, ["coT"]], "lg", [chkHudLg.Value, ["lgT"]])
    for n, cd in cards {                       ; some tudo de quem está desligado
        for sfx in ["F", "I", "H"]
            hudPnlW[n sfx].Visible := !!cd[1]
        for t in cd[2]
            hudPnlW[t].Visible := !!cd[1]
    }
    y := Round(62 * k)
    if chkHudSt.Value {
        h := Round(62 * k)
        HudBox("st", m, y, bw, h, k)
        hudPnlW["stT"].Move(m + pad, y + Round(14 * k), tw, Round(20 * k))
        hudPnlW["stS"].Move(m + pad, y + Round(36 * k), tw, Round(18 * k))
        y += h + Round(18 * k)
    }
    if chkHudMd.Value {
        h := Round(98 * k)
        HudBox("md", m, y, bw, h, k)
        hudPnlW["mdN"].Move(m + pad, y + Round(14 * k), tw, Round(36 * k))
        hudPnlW["mdP"].Move(m + pad, y + Round(52 * k), tw, Round(28 * k))
        hudPnlW["mdA"].Move(m + pad, y + Round(80 * k), tw, Round(16 * k))
        y += h + Round(18 * k)
    }
    for bx in [["wv", chkHudWv, "wvT"], ["gd", chkHudGd, "gdT"]] {
        if bx[2].Value {
            h := Round(52 * k)
            HudBox(bx[1], m, y, bw, h, k)
            hudPnlW[bx[3]].Move(m + pad, y + Round(14 * k), tw, Round(28 * k))
            y += h + Round(18 * k)
        }
    }
    if chkHudCo.Value {
        h := Round(70 * k)
        HudBox("co", m, y, bw, h, k)
        hudPnlW["coT"].Move(m + pad, y + Round(14 * k), tw, h - Round(18 * k))
        y += h + Round(18 * k)
    }
    if chkHudLg.Value {
        h := Max(Round(70 * k), ph - y - Round(40 * k))
        HudBox("lg", m, y, bw, h, k)
        hudPnlW["lgT"].Move(m + pad, y + Round(14 * k), tw, h - Round(18 * k))
        hudPnlLogN := Max(3, (h - Round(22 * k)) // Round(15 * k))
    } else
        ph := Max(Round(110 * k), y + Round(24 * k))     ; sem Logs o painel encolhe
    hudPnlW["role"].Move(m + Round(4 * k), ph - Round(28 * k), Round(120 * k), Round(20 * k))
    hudPnlW["upd"].Move(pw - m - Round(150 * k), ph - Round(30 * k), Round(150 * k), Round(22 * k))
    RoundCtrl(hudPnlW["upd"], 11)
    return ph
}

; troca a cor de um controle só quando mudou (evita piscar)
HudCol(nm, col) {
    global hudPnlW, hudColCache
    if (col = "" || (hudColCache.Has(nm) && hudColCache[nm] = col))
        return
    hudColCache[nm] := col
    hudPnlW[nm].SetFont("c" col)
}

HudPanelText() {
    global hudPnlW, hudLogs, hudPnlLogN, USER_FIRST, running, monStart, launches, discCount, prevCur, dashTitle, pendingUpd
    global farmMode, farmWave, farmPearls, farmPrev, farmModeCol, farmPearlCol, curStateCol, C_TEXT, C_MUTED, farmGuild, chkHudGd
    SetIf(hudPnlW["hello"], TT("hud_welcome", USER_FIRST))
    HudCol("dot", curStateCol)
    SetIf(hudPnlW["stT"], dashTitle.Value)
    SetIf(hudPnlW["stS"], "⏱ " (AfkStr()) "    🔁 " launches "    📉 " discCount)
    if (farmMode != "") {
        SetIf(hudPnlW["mdN"], farmMode)
        HudCol("mdN", farmModeCol != "" ? farmModeCol : C_TEXT)
        SetIf(hudPnlW["mdP"], farmPearls != "" ? "🦪 +" farmPearls : "")
        HudCol("mdP", farmPearlCol != "" ? farmPearlCol : C_TEXT)
        SetIf(hudPnlW["mdA"], farmPrev != "" ? TT("f_prevround") ": +" farmPrev : "")
    } else {
        SetIf(hudPnlW["mdN"], TT("f_reading"))
        HudCol("mdN", C_MUTED)
        SetIf(hudPnlW["mdP"], "")
        SetIf(hudPnlW["mdA"], "")
    }
    SetIf(hudPnlW["wvT"], farmWave != "" ? farmWave : "—")
    SetIf(hudPnlW["gdT"], farmGuild != "" ? "#" farmGuild : "—")
    co := ""
    for c in CurrencySpec()
        if (prevCur.Has(c.name) && prevCur[c.name] != "")
            co .= DefaultEmoji(c.name) " " c.name ": " Compact(prevCur[c.name]) "`n"
    SetIf(hudPnlW["coT"], co = "" ? "—" : RTrim(co, "`n"))
    lg := ""
    i := Max(1, hudLogs.Length - hudPnlLogN + 1)
    while (i <= hudLogs.Length) {
        lg .= hudLogs[i] "`n"
        i++
    }
    SetIf(hudPnlW["lgT"], RTrim(lg, "`n"))
    hudPnlW["upd"].Visible := (pendingUpd != "")
}

HudPanelPos(v, k, h) {
    global hudMode, hudPnl, hudPnlKey
    if (hudMode != 4) {
        try hudPnl.Hide()
        hudPnlKey := ""
        return
    }
    pw := Round(244 * k), ph := Max(Round(470 * k), h)
    MonitorGetWorkArea(MonitorGetPrimary(), &wl)
    px := (v[1] - pw >= wl) ? v[1] - pw : v[1]
    key := px "," v[2] "," pw "," ph
    if (key = hudPnlKey && DllCall("IsWindowVisible", "Ptr", hudPnl.Hwnd))
        return
    hudPnlKey := key
    ph := HudPanelLayout(pw, ph, k)
    hudPnl.Show(Format("NA x{} y{} w{} h{}", px, v[2], pw, ph))
    try WinSetTransparent((px < v[1]) ? "Off" : 235, hudPnl.Hwnd)
    DllCall("SetWindowRgn", "Ptr", hudPnl.Hwnd, "Ptr", DllCall("CreateRoundRectRgn", "Int", 0, "Int", 0, "Int", pw + 1, "Int", ph + 1, "Int", Round(16 * k), "Int", Round(16 * k), "Ptr"), "Int", 1)
}

HudApply() {
    global hudMode, chkFrame, hudBar
    if !IsObject(hudBar)
        HudBuild()
    if (hudMode || chkFrame.Value)
        SetTimer(HudTick, 250)
    else
        SetTimer(HudTick, 0)
    HudTick(true)
}

HudHideAll() {
    global hudBar, hudPan, hudFrame, hudSide, hudShown, hudPnl
    for w in [hudBar, hudPan, hudFrame, hudSide, hudPnl]
        try w.Hide()
    hudShown := false
}

; dono = janela do Roblox (o HUD acompanha ela)
HudOwn(gui, hw) {
    DllCall(A_PtrSize = 8 ? "SetWindowLongPtr" : "SetWindowLong", "Ptr", gui.Hwnd, "Int", -8, "Ptr", hw)
}

HudTick(force := false) {
    global hudPnl
    global hudMode, chkFrame, hudBar, hudBarDot, hudBarL, hudBarR, hudPan, hudPanDot, hudPanT, hudPanL, hudFrame, hudSide, hudSideDot, hudSideT, hudSideL
    global hudLastPos, hudLastHw, hudN, hudUserHidden, hudShown, hudFrameCol, chkHudCo
    global curState, curStateCol, running, monStart, launches, discCount, prevCur, dashTitle, dayOnline
    if !IsObject(hudBar)
        return
    hw := FindGameWindow()
    if (hudUserHidden || !hw || DllCall("IsIconic", "Ptr", hw) || !DllCall("IsWindowVisible", "Ptr", hw)
        || (!hudMode && !chkFrame.Value)) {
        if hudShown
            HudHideAll()
        hudLastPos := ""
        return
    }
    k := A_ScreenDPI / 96
    v := VisibleRect(hw)
    pos := v[1] "," v[2] "," v[3] "," v[4] "," hudMode "," chkFrame.Value
    moved := force || pos != hudLastPos || hw != hudLastHw
    if (hw != hudLastHw) {
        for w in [hudBar, hudPan, hudFrame, hudSide, hudPnl]
            HudOwn(w, hw)
        hudLastHw := hw
    }
    ; ---- texto (1x por segundo) ----
    if (force || moved || Mod(++hudN, 4) = 0) {
        col := curStateCol
        stats := (running ? "⏱ " DurStr(A_TickCount - monStart) : TT("up_stopped")) "   🔁 " launches "   📉 " discCount
        coins := ""
        for c in CurrencySpec()
            if (chkHudCo.Value && prevCur.Has(c.name) && prevCur[c.name] != "")
                coins .= "   " DefaultEmoji(c.name) " " Compact(prevCur[c.name])
        ms := Buffer(64, 0), NumPut("UInt", 64, ms), DllCall("GlobalMemoryStatusEx", "Ptr", ms)
        pc := "CPU " CpuLoad() "%  ·  RAM " NumGet(ms, 4, "UInt") "%"
        if (hudMode = 1) {
            hudBarDot.SetFont("c" col)
            SetIf(hudBarL, dashTitle.Value "   " stats coins)
            SetIf(hudBarR, pc)
        } else if (hudMode = 2) {
            hudPanDot.SetFont("c" col)
            SetIf(hudPanT, dashTitle.Value)
            SetIf(hudPanL, stats (coins != "" ? "`n" LTrim(coins) : "") "`n" pc)
        } else if (hudMode = 3) {
            hudSideDot.SetFont("c" col)
            SetIf(hudSideT, dashTitle.Value)
            ln := "⏱ " (AfkStr())
            ln .= "`n🔁 " TT("f_reopens") ": " launches "    📉 " TT("f_drops") ": " discCount
            ln .= "`n🟢 " TT("f_online_today") ": " DurStr(dayOnline * 1000)
            for c in CurrencySpec()
                if (chkHudCo.Value && prevCur.Has(c.name) && prevCur[c.name] != "")
                    ln .= "`n" DefaultEmoji(c.name) " " c.name ": " Compact(prevCur[c.name])
            ln .= "`n`n🖥 CPU " CpuLoad() "%   ·   RAM " NumGet(ms, 4, "UInt") "%"
            rram := RobloxMaxRamMB()
            if (rram >= 0)
                ln .= "`n🎮 Roblox: " (rram >= 1024 ? Round(rram / 1024, 2) " GB" : rram " MB")
            SetIf(hudSideL, ln)
        } else if (hudMode = 4)
            HudPanelText()
        if (chkFrame.Value && col != hudFrameCol) {
            hudFrame.BackColor := col
            hudFrameCol := col
        }
    }
    if !moved {
        if !hudShown
            moved := true
        else
            return
    }
    hudLastPos := pos
    ; ---- posição ----
    w := v[3] - v[1], h := v[4] - v[2]
    if (hudMode = 1) {
        bh := Round(28 * k)
        MonitorGetWorkArea(MonitorGetPrimary(), , , , &wb)
        by := (v[4] + bh <= wb) ? v[4] : v[4] - bh       ; embaixo da janela; se não couber, por dentro
        hudBarL.Move(, , w - Round(190 * k))
        hudBarR.Move(w - Round(160 * k), , Round(150 * k))
        hudBar.Show(Format("NA x{} y{} w{} h{}", v[1], by, w, bh))
        DllCall("SetWindowRgn", "Ptr", hudBar.Hwnd, "Ptr", DllCall("CreateRoundRectRgn", "Int", 0, "Int", 0, "Int", w + 1, "Int", bh + 1, "Int", Round(10 * k), "Int", Round(10 * k), "Ptr"), "Int", 1)
    } else
        try hudBar.Hide()
    if (hudMode = 2) {
        WinGetClientPos(&cx, &cy, , , hw)
        pw := Round(244 * k), ph := Round(98 * k)
        hudPan.Show(Format("NA x{} y{} w{} h{}", cx + Round(12 * k), cy + Round(60 * k), pw, ph))
        WinSetTransparent(225, hudPan.Hwnd)
        DllCall("SetWindowRgn", "Ptr", hudPan.Hwnd, "Ptr", DllCall("CreateRoundRectRgn", "Int", 0, "Int", 0, "Int", pw + 1, "Int", ph + 1, "Int", Round(14 * k), "Int", Round(14 * k), "Ptr"), "Int", 1)
    } else
        try hudPan.Hide()
    if (hudMode = 3) {
        sw := Round(234 * k), sh := Round(326 * k)
        MonitorGetWorkArea(MonitorGetPrimary(), , , &wr)
        sx := (v[3] + sw <= wr) ? v[3] : v[3] - sw      ; à direita da janela; se não couber, por dentro
        hudSide.Show(Format("NA x{} y{} w{} h{}", sx, v[2], sw, sh))
        WinSetTransparent((sx < v[3]) ? 235 : "Off", hudSide.Hwnd)
        DllCall("SetWindowRgn", "Ptr", hudSide.Hwnd, "Ptr", DllCall("CreateRoundRectRgn", "Int", 0, "Int", 0, "Int", sw + 1, "Int", sh + 1, "Int", Round(14 * k), "Int", Round(14 * k), "Ptr"), "Int", 1)
    } else
        try hudSide.Hide()
    HudPanelPos(v, k, h)
    if chkFrame.Value {
        t := Max(2, Round(3 * k))
        hudFrame.Show(Format("NA x{} y{} w{} h{}", v[1], v[2], w, h))
        outer := DllCall("CreateRectRgn", "Int", 0, "Int", 0, "Int", w, "Int", h, "Ptr")
        inner := DllCall("CreateRectRgn", "Int", t, "Int", t, "Int", w - t, "Int", h - t, "Ptr")
        DllCall("CombineRgn", "Ptr", outer, "Ptr", outer, "Ptr", inner, "Int", 4)
        DllCall("DeleteObject", "Ptr", inner)
        DllCall("SetWindowRgn", "Ptr", hudFrame.Hwnd, "Ptr", outer, "Int", 1)
    } else
        try hudFrame.Hide()
    hudShown := true
}

; arredonda controles, joga os fundos pro fundo da pilha e arredonda as janelas
; ==========================================================
;  Suporte: relatório de erro -> webhook secreto (sem IP, sem dado pessoal)
; ==========================================================
SendReport() {
    global edReport, chkReportShot, repStatus, REPORT_WEBHOOK, APP_NAME, USER_NAME, VERSION, LOGO_URL, iniFile, ANON_ID, LANG, reportImg
    txt := Trim(edReport.Value)
    if (txt = "") {
        repStatus.Value := TT("report_need_text")
        return
    }
    if (Trim(REPORT_WEBHOOK) = "") {
        repStatus.Value := TT("report_nodest")
        return
    }
    repStatus.Value := TT("report_sending")
    shot := "", fname := "roblox.png"
    if (reportImg != "" && FileExist(reportImg)) {        ; imagem escolhida pelo usuário tem prioridade
        shot := reportImg
        SplitPath(reportImg, , , &ext)
        fname := "report." StrLower(ext)
    } else if chkReportShot.Value {
        hw := FindGameWindow()
        if (hw && WinGetMinMax(hw) != -1) {
            try if CaptureWindowPng(hw, A_Temp "\roblox_report.png")
                shot := A_Temp "\roblox_report.png"
        }
    }
    key := IniRead(iniFile, "cfg", "key", "")
    fields := [[TT("f_report_user"), USER_NAME, true]
        , [TT("f_report_pc"), A_ComputerName, true]
        , [TT("f_report_id"), ANON_ID, true]
        , [TT("f_version"), "v" VERSION, true]
        , [TT("f_report_os"), "Windows " A_OSVersion "  ·  " (A_Is64bitOS ? "x64" : "x86"), true]
        , [TT("f_report_lang"), LANG, true]]
    if (Trim(key) != "")
        fields.Push([TT("f_report_lic"), "``" SubStr(key, 1, 40) "``", false])
    ts := FormatTime(A_NowUTC, "yyyy-MM-dd") "T" FormatTime(A_NowUTC, "HH:mm:ss") "Z"
    e := '{"username":"' JsonEsc(APP_NAME " Report") '","avatar_url":"' LOGO_URL '","allowed_mentions":{"parse":[]},"embeds":[{'
       . '"author":{"name":"' JsonEsc(APP_NAME) '","icon_url":"' LOGO_URL '"},'
       . '"title":"' JsonEsc("🐞  " TT("ev_report")) '","color":' 0xF5A142 ','
       . '"description":"' JsonEsc(txt) '",' FieldsJson(fields)
       . (shot != "" ? '"image":{"url":"attachment://' fname '"},' : '')
       . '"footer":{"text":"' JsonEsc(APP_NAME "  •  v" VERSION) '","icon_url":"' LOGO_URL '"},'
       . '"timestamp":"' ts '"}]}'
    try {
        if (shot != "" && FileExist(shot))
            SendWebhookImage(REPORT_WEBHOOK, e, shot, "", ReportCb, fname)
        else
            HttpPost(REPORT_WEBHOOK, e, "application/json", "", ReportCb)
    } catch as err {
        repStatus.Value := TT("report_fail", err.Message)
    }
}

ReportCb(h) {
    global repStatus, edReport, reportImg, repImgLbl
    st := HttpStatus(h)
    if (st >= 200 && st < 300) {
        repStatus.Value := TT("report_sent")
        edReport.Value := ""
        reportImg := ""
        try repImgLbl.Value := TT("report_noimg")
    } else
        repStatus.Value := TT("report_fail", "HTTP " st)
}

PickReportImg(*) {
    global reportImg, repImgLbl
    f := FileSelect(3, , TT("btn_report_img"), "Imagens (*.png; *.jpg; *.jpeg; *.gif)")
    if (f = "")
        return
    reportImg := f
    SplitPath(f, &nm)
    repImgLbl.Value := TT("report_img_set", nm)
}

