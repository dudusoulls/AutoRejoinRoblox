; teste de UMA área só (botão "Testar" de cada linha em Leitura)
AreaTestOne(an, *) {
    ReadUncovered(AreaTestOneRun.Bind(an))
}

AreaTestOneRun(an) {
    global areaRes, areaKey
    hw := FindGameWindow()
    if !IsObject(areaRes)
        return
    if !(hw && WinGetMinMax(hw) != -1 && DllCall("IsWindowVisible", "Ptr", hw)) {
        areaRes.Value := TT("area_need_roblox")
        return
    }
    areaRes.Value := TT("area_testing")
    name := TT(areaKey[an]), val := "", raw := ""
    try {
        switch an {
            case "mode":
                r := OcrAreaRead(hw, "mode", (t) => RegExMatch(t, "[A-Za-z]{4}"))
                raw := r.text
                if r.ok
                    for line in r.res.Lines {
                        t := Trim(RegExReplace(line.Text, "\s+", " "))
                        if (RegExMatch(t, "[A-Za-z]{4}") && !RegExMatch(t, "i)^wave\b")) {
                            val := ModeClean(t)
                            break
                        }
                    }
            case "wave":
                r := OcrAreaRead(hw, "wave", (t) => RegExMatch(t, "\d"))
                raw := r.text
                if RegExMatch(raw, "i)wave\s*([0-9OolI]{1,4})", &m)
                    val := m[1]
                else if RegExMatch(raw, "([0-9OolI]{1,4})\s*$", &m)
                    val := m[1]
                val := StrReplace(StrReplace(StrReplace(StrReplace(val, "O", "0"), "o", "0"), "l", "1"), "I", "1")
            case "pearls":
                r := OcrAreaRead(hw, "pearls", (t) => RegExMatch(t, "\d"))
                raw := r.text
                if RegExMatch(raw, "\+?\s*(\d[\d.,]*[kKmMbB]?)", &m)
                    val := "+" m[1]
            case "coins":
                cur := ReadCurrencies(hw)[2]
                for k, v in cur
                    val .= (val = "" ? "" : "  ·  ") k " " v
            case "guild":
                gr := ReadGuildRank(hw)
                val := gr != "" ? "#" gr : ""
                global guildSeen
                raw := guildSeen
        }
    } catch as e {
        raw := e.Message
    }
    areaRes.Value := (val != "" ? "✔ " : "✖ ") name ": " (val != "" ? val : "—") (raw != "" ? "`n" TT("area_saw") " [" SubStr(raw, 1, 120) "]" : "")
}

; ---------- mostra na tela onde ele está lendo (contornos coloridos sobre o Roblox) + tamanho da janela ----------
AreaShowTick() {
    global chkAreaShow, areaOn, chkHudGd, areaKey, advSize, shotBusy
    static wins := Map(), shown := false, sizeTxt := ""
    hw := FindGameWindow()
    ok := hw && !DllCall("IsIconic", "Ptr", hw) && DllCall("IsWindowVisible", "Ptr", hw)
    if IsObject(advSize) {
        txt := TT("adv_nowin")
        if ok {
            WinGetClientPos(, , &qw, &qh, hw)
            txt := TT("adv_size", qw, qh)
        }
        if (txt != sizeTxt) {
            sizeTxt := txt
            advSize.Value := txt
        }
    }
    if (shotBusy || !(chkAreaShow.Value && !areaOn && ok)) {
        if shown {
            for n, o in wins
                try o.frm.Hide(), o.lab.Hide(), o.vis := false
            shown := false
        }
        return
    }
    WinGetClientPos(&cx, &cy, &cw, &ch, hw)
    cols := Map("mode", "5BE37D", "wave", "FFD84D", "pearls", "FF7AC8", "coins", "FFA23D", "guild", "4DD2FF")
    k := A_ScreenDPI / 96
    for n in ["mode", "wave", "pearls", "coins", "guild"] {
        vis := (n != "coins" || AreaIsSet("coins")) && (n != "guild" || chkHudGd.Value)
        if !wins.Has(n) {
            o := {key: "", vis: false, hw: 0}
            o.frm := Gui("-Caption +ToolWindow -DPIScale +E0x20 +E0x08000000")
            o.frm.BackColor := cols[n]
            o.lab := Gui("-Caption +ToolWindow -DPIScale +E0x20 +E0x08000000")
            o.lab.BackColor := cols[n]
            o.lab.SetFont("s8 w700", "Segoe UI")
            lt := o.lab.Add("Text", "x5 y1 c101018 BackgroundTrans", TT(areaKey[n]))
            lt.GetPos(, , &tw, &th)
            o.lw := tw + 10, o.lh := th + 2
            wins[n] := o
        }
        o := wins[n]
        if !vis {
            if o.vis {
                o.frm.Hide(), o.lab.Hide()
                o.vis := false
            }
            continue
        }
        ar := AreaGet(n, cw, ch)
        x := cx + Round(ar[1] * cw), y := cy + Round(ar[2] * ch), w := Max(8, Round(ar[3] * cw)), h := Max(8, Round(ar[4] * ch))
        key := x "," y "," w "," h
        if (key != o.key || !o.vis || o.hw != hw) {
            if (o.hw != hw) {
                HudOwn(o.frm, hw), HudOwn(o.lab, hw)
                o.hw := hw
            }
            o.key := key
            o.frm.Show(Format("NA x{} y{} w{} h{}", x, y, w, h))
            t := Max(2, Round(2 * k))
            outer := DllCall("CreateRectRgn", "Int", 0, "Int", 0, "Int", w, "Int", h, "Ptr")
            inner := DllCall("CreateRectRgn", "Int", t, "Int", t, "Int", Max(t + 1, w - t), "Int", Max(t + 1, h - t), "Ptr")
            DllCall("CombineRgn", "Ptr", outer, "Ptr", outer, "Ptr", inner, "Int", 4)
            DllCall("DeleteObject", "Ptr", inner)
            DllCall("SetWindowRgn", "Ptr", o.frm.Hwnd, "Ptr", outer, "Int", 1)
            ly := (y - o.lh >= cy) ? y - o.lh : y + h
            o.lab.Show(Format("NA x{} y{} w{} h{}", x, ly, o.lw, o.lh))
            o.vis := true
        }
    }
    shown := true
}

