; ---- versão do Roblox ----
; instalada: pasta "version-xxxx" do processo aberto (ou da instalação mais recente)
RbxInstalled() {
    exe := ""
    try exe := WinGetProcessPath("ahk_exe RobloxPlayerBeta.exe")
    if (exe = "")
        exe := NewestRobloxExe(true)
    if (exe = "")
        return {ver: "", up: ""}
    SplitPath(exe, , &dir)
    SplitPath(dir, &folder)
    v := ""
    try v := FileGetVersion(exe)
    return {ver: StrReplace(v, ",", "."), up: folder}
}

; mais recente: API pública de versões do cliente do Roblox (consulta em segundo plano, a cada 10 min)
RbxLatestFetch() {
    global rbxLatestT
    if (A_TickCount - rbxLatestT < 600000 && rbxLatestT)
        return
    rbxLatestT := A_TickCount
    try AsyncReq("GET", "https://clientsettings.roblox.com/v2/client-version/WindowsPlayer", , , , RbxLatestCb)
}

RbxLatestCb(h) {
    global rbxLatest, rbxLatestUp, rbxLatestT
    try {
        if (HttpStatus(h) = 200) {
            t := h.ResponseText
            if RegExMatch(t, '"version"\s*:\s*"([^"]+)"', &m)
                rbxLatest := m[1]
            if RegExMatch(t, '"clientVersionUpload"\s*:\s*"([^"]+)"', &m2)
                rbxLatestUp := m2[1]
            return
        }
    }
    rbxLatestT := A_TickCount - 540000   ; falhou: tenta de novo em ~1 min
}

; true quando a versão mais nova INSTALADA não é a que o Roblox publicou como atual (e não há versão fixada)
RbxIsOutdated() {
    global rbxLatestUp, edRbxVer
    RbxLatestFetch()
    if (rbxLatestUp = "" || Trim(edRbxVer.Value) != "")
        return false
    exe := NewestRobloxExe(true)
    if (exe = "")
        return false
    SplitPath(exe, , &dir)
    SplitPath(dir, &folder)
    return folder != rbxLatestUp
}

RbxVerUpdate() {
    global rbxLatest, rbxLatestUp, stRbxCur, stRbxNew, stRbxTag, C_MUTED
    RbxLatestFetch()
    cur := RbxInstalled()
    SetIf(stRbxCur, TT("rbx_ver_cur") ": " (cur.ver != "" ? cur.ver : "—") (cur.up != "" ? "  (" SubStr(cur.up, 9, 6) ")" : ""))
    SetIf(stRbxNew, TT("rbx_ver_new") ": " (rbxLatest != "" ? rbxLatest : "…") (rbxLatestUp != "" ? "  (" SubStr(rbxLatestUp, 9, 6) ")" : ""))
    tag := "", col := "8A8F98"
    if (cur.up != "" && rbxLatestUp != "") {
        if (cur.up = rbxLatestUp && !RbxIsOutdated())
            tag := TT("rbx_ver_ok"), col := "4ADE80"
        else
            tag := TT("rbx_ver_old"), col := "FBBF24"
    }
    SetIf(stRbxTag, tag)
    try stRbxTag.SetFont("c" col)
}

UpdateStats() {
    global stVals, mSub, running, monStart, launches, discCount, lastDiscShort, dayOnline, iniFile
    SetIf(stVals[1], AfkStr("—"))
    static sv := 0
    if (running && Mod(++sv, 30) = 0)
        AfkSave()
    SetIf(stVals[2], launches)
    SetIf(stVals[3], discCount)
    SetIf(stVals[4], lastDiscShort)
    static rv := 0
    if (Mod(rv++, 15) = 0)
        RbxVerUpdate()
    global farmGuild, farmMode, farmWave
    SetIf(stGuild, farmGuild != "" ? "#" farmGuild : "—")
    SetIf(stMode, farmMode != "" ? farmMode (farmWave != "" ? "  ·  W" farmWave : "") : "—")
    SetIf(mSub, TT("mini_sub", launches, discCount))
    ; tempo online de hoje (pro resumo diário)
    static n := 0
    if (running && IsRobloxOpen()) {
        DayRoll()
        dayOnline++
        if (Mod(++n, 60) = 0)
            IniWrite(dayOnline, iniFile, "day", "online")
    }
}

SetCompact(on) {
    global g, gm, miniShown, iniFile, winW, W, H, hudMode, chkHudComp
    IniWrite(on ? 1 : 0, iniFile, "cfg", "compact")
    if (on && hudMode && chkHudComp.Value) {   ; o HUD grudado no Roblox faz o papel do modo compacto
        FadeHide(g)
        FadeHide(gm)
        HudApply()
