; posta no canal (webhook do rank, ou o webhook principal) a mensagem do novo rank com data/hora e print do boneco
GuildPost(old, new, test := false, periodic := false) {
    global edGuildHook, edHook, guildTrk, chkShotFollow, USER_NAME, APP_NAME, LOGO_URL, VERSION
    url := Trim(edGuildHook.Value), auth := "", head := '"username":"Auto Reconnect","avatar_url":"' LOGO_URL '",'
    if (InStr(url, "https://discord.com/api/webhooks/") != 1) {
        url := ""
        if !DiscordDest(&url, &auth, &head)
            return
    }
    fmt := (n) => StrReplace(FmtNum(Integer(n)), ",", " ")
    delta := ""
    if (IsInteger(old) && IsInteger(new)) {
        d := Integer(old) - Integer(new)            ; número menor = rank melhor
        if (d > 0)
            delta := "▲ subiu " fmt(d)
        else if (d < 0)
            delta := "▼ caiu " fmt(-d)
    }
    shot := ""
    hw := FindGameWindow()
    global shotBusy
    if (hw && WinGetMinMax(hw) != -1) {
        shotBusy := true                        ; esconde os contornos de "Mostrar áreas" pra não saírem no print
        try AreaShowTick()
        Sleep(150)
        try {
            rc := Buffer(16, 0)
            DllCall("GetClientRect", "Ptr", hw, "Ptr", rc)
            cw := NumGet(rc, 8, "Int"), chh := NumGet(rc, 12, "Int")
            ga := AreaGet("guild", cw, chh)
            gcx := (ga[1] + ga[3] / 2) * cw, gcy := (ga[2] + ga[4] / 2) * chh      ; onde a área do rank está configurada
            if IsObject(guildTrk)
                px := guildTrk[1] + guildTrk[3] / 2, py := guildTrk[2] + guildTrk[4] / 2
            else
                px := gcx, py := gcy
            if AreaIsSet("guildshot") {                                         ; recorte escolhido pelo usuário
                sa := AreaGet("guildshot", cw, chh)
                cxr := sa[1] * cw, cyr := sa[2] * chh, bw := Round(sa[3] * cw), bh := Round(sa[4] * chh)
                if (IsObject(guildTrk) && IsObject(chkShotFollow) && chkShotFollow.Value)
                    cxr += px - gcx, cyr += py - gcy                            ; o recorte acompanha o rank (boneco se move)
                cropX := Round(cxr), cropY := Round(cyr)
            } else {
                bw := Round(cw * 0.30), bh := Round(chh * 0.36)
                cropX := Round(px - bw / 2), cropY := Round(py - bh * 0.66)
            }
            f := A_Temp "\guild_rank.png"
            if CaptureWindowPng(hw, f, cropX, cropY, bw, bh)
                shot := f
        }
        shotBusy := false
    }
    now := DateDiff(A_NowUTC, "19700101000000", "Seconds")
    ts := FormatTime(A_NowUTC, "yyyy-MM-dd") "T" FormatTime(A_NowUTC, "HH:mm:ss") "Z"
    desc := "# #" fmt(new) "`n-# 🕒 <t:" now ":F>  ·  <t:" now ":R>`n"
    if (!periodic && old != "")
        desc .= "> " "Antes: **#" fmt(old) "**" (delta != "" ? "  ·  " delta : "") "`n"
    e := '{' head '"allowed_mentions":{"parse":[]},'
        . '"content":"' (test ? "🧪 **Teste** — " : (periodic ? "⏱ " : "")) '``' JsonEsc(FormatTime(, "dd/MM/yyyy, HH:mm:ss")) '``",'
        . '"embeds":[{'
        . '"author":{"name":"' JsonEsc(APP_NAME "  ·  🛡 " TT("f_guild")) '","icon_url":"' LOGO_URL '"},'
        . '"color":' 0x6EA8FF ','
        . '"description":"' JsonEsc(desc) '",'
        . (shot != "" ? '"image":{"url":"attachment://rank.png"},' : '')
        . '"footer":{"text":"' JsonEsc(USER_NAME "  •  " A_ComputerName "  •  v" VERSION) '","icon_url":"' LOGO_URL '"},'
        . '"timestamp":"' ts '"'
        . '}]}'
    if (shot != "")
        SendWebhookImage(url, e, shot, auth, 0, "rank.png")
    else
        HttpPost(url, e, "application/json", auth, 0)
}

; envia o rank atual a cada X minutos (ini [cfg] guildEvery; 0 = desligado)
GuildEveryTick() {
    global aaMode, farmGuild
    static last := 0
    if !aaMode
        return
    every := 0
    try every := Integer(IniRead(iniFile, "cfg", "guildEvery", "0"))
    if (every <= 0 || farmGuild = "") {
        last := 0
        return
    }
    if !last {
        last := A_TickCount
        return
    }
    if (A_TickCount - last >= every * 60000) {
        last := A_TickCount
        try GuildPost("", farmGuild, false, true)
    }
}

