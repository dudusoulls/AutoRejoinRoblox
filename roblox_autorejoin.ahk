; ---------------- Moedas (OCR) ----------------
NormTok(s) {
    return StrLower(RegExReplace(s, "[^\p{L}\p{N}]"))
}

ParseNum(s) {
    if RegExMatch(s, "i)[kmb]$")
        return ""
    d := RegExReplace(s, "\D")
    return (d = "") ? "" : Integer(d)
}

FmtNum(n) {
    sign := (n < 0) ? "-" : ""
    return sign RegExReplace(Abs(n), "\G\d+?(?=(\d{3})+$)", "$0,")
}

; Lê as moedas na janela do Roblox. Retorna Map(nome -> texto do valor) na ordem dos nomes.
; Procura cada nome na tela e pega o número logo acima (ou do lado) dele.
ReadCurrencies(hw) {
    global edCur, lastOcrText, aaMode
    if !aaMode                       ; moedas são do Modo AA
        return [[], Map()]
    labels := []
    for c in CurrencySpec()
        labels.Push(c.name)
    found := Map()
    if !labels.Length
        return [labels, found]

    ; barra de moedas sem nomes (só ícone + número): se a área "Moedas" foi marcada, lê os números da esquerda pra direita
    ; e entrega na ordem da lista de moedas (Gems, Gold, Summer Pearls…)
    if AreaIsSet("coins") {
        bar := ReadCoinBar(hw)
        if bar.Count
            return [labels, bar]
    }

    ; tenta jeitos diferentes de capturar até achar pelo menos um nome
    ; mode 4 = PrintWindow (funciona com janela coberta), 0 = copia da tela
    lastOcrText := ""
    ; começa pelo jeito que funcionou da última vez; os outros só de vez em quando
    static opts := [{scale: 3, mode: 0}, {scale: 3, mode: 4}, {scale: 3, mode: 0, grayscale: 1, invertcolors: 1}]
    static best := 1, lastFull := 0
    f := MatchCurrencies(labels, OcrWords(hw, opts[best]))
    if f.Count
        return [labels, f]
    if (A_TickCount - lastFull < 180000 && lastFull)
        return [labels, Map()]
    lastFull := A_TickCount
    for i, opt in opts {
        if (i = best)
            continue
        f := MatchCurrencies(labels, OcrWords(hw, opt))
        if f.Count {
            best := i
            return [labels, f]
        }
    }
    return [labels, Map()]
}

; Lê só os números da barra: amplia a área, deixa só o que é claro (branco/amarelo/rosa), tira o azul-ciano do cenário
ReadCoinBar(hw) {
    global lastOcrText
    out := Map()
    specs := CurrencySpec()
    if !specs.Length
        return out
    try {
        WinGetClientPos(, , &cw, &chh, hw)
        ar := AreaGet("coins", cw, chh)
        AreaPx(ar, cw, chh, &ox, &oy, &ow, &oh)
        seen := "", attempts := [], mx := 0
        for r in PreOcr(hw, ox, oy, ow, oh, "coin", [150, 175, 200]) {
            seen .= (seen = "" ? "" : " | ") SubStr(RegExReplace(r.text, "\s+", " "), 1, 60)
            nums := []
            for wd in r.words {
                t := RegExReplace(wd.t, "[^0-9OoIlSsBZz.,kKmMbB]")
                if (RegExMatch(t, "^[0-9OoIlSsBZz][0-9OoIlSsBZz.,]*[kKmMbB]?$") && RegExMatch(t, "\d"))
                    nums.Push({x: wd.x, ex: wd.x + wd.w, sc: r.sc, pad: r.pad, t: RegExReplace(FixDigits(t), "[^\d.,kKmMbB]+$")})
            }
            Loop nums.Length - 1 {
                i := A_Index
                Loop nums.Length - i
                    if (nums[A_Index].x > nums[A_Index + 1].x)
                        tmp := nums[A_Index], nums[A_Index] := nums[A_Index + 1], nums[A_Index + 1] := tmp
            }
            attempts.Push(nums), mx := Max(mx, nums.Length)
        }
        ; entre as leituras com mais números, vota por posição (corrige 8↔0 etc.)
        best := []
        Loop mx {
            idx := A_Index, votes := Map(), ref := 0
            for nums in attempts
                if (nums.Length = mx) {
                    votes[nums[idx].t] := (votes.Has(nums[idx].t) ? votes[nums[idx].t] : 0) + 1
                    if !ref
                        ref := nums[idx]
                }
            bt := "", bv := 0
            for k, v in votes
                if (v > bv || (v = bv && StrLen(k) > StrLen(bt)))
                    bt := k, bv := v
            best.Push({t: bt, ex: ref.ex, sc: ref.sc, pad: ref.pad})
        }
        lastOcrText .= "[barra de moedas] " seen "`n"
        used := Map()
        for i, n in best {
            kind := CoinIconKind(hw, ox + (n.ex - n.pad) / n.sc, oy, oh * 1.3, oh)
            nm := ""
            for sp in specs {
                l := StrLower(sp.name)
                if (!used.Has(sp.name) && ((kind = "gold" && (InStr(l, "gold") || InStr(l, "coin")))
                    || (kind = "pearl" && InStr(l, "pearl")) || (kind = "legacy" && InStr(l, "legacy"))
                    || (kind = "gem" && InStr(l, "gem") && !InStr(l, "legacy")))) {
                    nm := sp.name
                    break
                }
            }
            if (nm = "")
                for sp in specs
                    if !used.Has(sp.name) {
                        nm := sp.name
                        break
                    }
            if (nm != "")
                used[nm] := 1, out[nm] := n.t
        }
    }
    return out
}

; classifica o ícone da moeda pela cor: gold(amarelo) / pearl(rosa) / gem(ciano-arco-íris) / legacy(azul)
CoinIconKind(hw, rx, ry, rw, rh) {
    pt := Buffer(8, 0)
    NumPut("Int", Round(rx), pt, 0), NumPut("Int", Round(ry), pt, 4)
    DllCall("ClientToScreen", "Ptr", hw, "Ptr", pt)
    sx := NumGet(pt, 0, "Int"), sy := NumGet(pt, 4, "Int")
    dc := DllCall("GetDC", "Ptr", 0, "Ptr")
    if !dc
        return ""
    yel := 0, pnk := 0, cyn := 0, blu := 0
    yy := 0
    while (yy < rh) {
        xx := 0
        while (xx < rw) {
            c := DllCall("GetPixel", "Ptr", dc, "Int", sx + Round(xx), "Int", sy + yy, "UInt")
            if (c != 0xFFFFFFFF) {
                r := c & 0xFF, g := (c >> 8) & 0xFF, b := (c >> 16) & 0xFF
                mx := Max(r, g, b), mn := Min(r, g, b)
                if (mx >= 130 && mx - mn >= 70) {
                    if (mx = r && g >= b + 40 && g >= r * 0.55)
                        yel++
                    else if (mx = r && b > g + 25)
                        pnk++
                    else if (mx = b && g >= r + 50 && g > b * 0.6)
                        cyn++
                    else if (mx = b && r < g + 30 && g < b * 0.75)
                        blu++
                    else if (mx = g && b >= r)
                        cyn++
                    else if (mx = b && r > g + 30)
                        pnk++
                }
            }
            xx += 1.5
        }
        yy += 2
    }
    DllCall("ReleaseDC", "Ptr", 0, "Ptr", dc)
    tot := yel + pnk + cyn + blu
    if (tot < 6)
        return ""
    if (blu > cyn && blu > yel && blu > pnk)
        return "legacy"
    if (cyn * 6 >= tot)
        return "gem"
    return yel >= pnk ? "gold" : "pearl"
}

; maior zoom possível sem passar do limite de tamanho do OCR do Windows
OcrScale(hw, want) {
    try WinGetClientPos(, , &w, &h, hw)
    catch
        return 1
    big := Max(w, h, 1)
    lim := OCR.MaxImageDimension ? OCR.MaxImageDimension : 2600
    return Max(0.5, Min(want, Floor((lim - 20) / big * 10) / 10))
}

OcrWords(hw, opt) {
    global lastOcrText
    words := []
    opt := opt.Clone()
    opt.scale := OcrScale(hw, opt.scale)
    if AreaIsSet("coins") {                   ; o usuário marcou onde ficam as moedas
        try {
            WinGetClientPos(, , &cw, &chh, hw)
            ar := AreaGet("coins", cw, chh)
            opt.x := Round(cw * ar[1]), opt.y := Round(chh * ar[2]), opt.w := Max(24, Round(cw * ar[3])), opt.h := Max(16, Round(chh * ar[4]))
        }
    }
    try {
        res := OCR.FromWindow("ahk_id " hw, opt)
    } catch as e {
        lastOcrText .= "[erro mode " opt.mode ": " e.Message "]`n"
        return words
    }
    lastOcrText .= "[mode " opt.mode "] " SubStr(RegExReplace(res.Text, "\s+", " "), 1, 300) "`n"
    for line in res.Lines {
        li := A_Index
        for wd in line.Words
            words.Push({t: NormTok(wd.Text), raw: wd.Text, x: wd.x, y: wd.y, w: wd.w, h: wd.h, line: li, used: false})
    }
    return words
}

; distância de edição (aceita 1 letra errada do OCR, ex: "Gerns" = "Gems")
Lev(a, b) {
    la := StrLen(a), lb := StrLen(b)
    if !la
        return lb
    if !lb
        return la
    prev := []
    Loop lb + 1
        prev.Push(A_Index - 1)
    Loop la {
        i := A_Index, cur := [i], ca := SubStr(a, i, 1)
        Loop lb {
            j := A_Index
            cost := (ca = SubStr(b, j, 1)) ? 0 : 1
            cur.Push(Min(prev[j + 1] + 1, cur[j] + 1, prev[j] + cost))
        }
        prev := cur
    }
    return prev[lb + 1]
}

TokEq(a, b) {
    if (a = b)
        return true
    return StrLen(b) >= 4 && Lev(a, b) <= 1
}

MatchCurrencies(labels, words) {
    found := Map()

    ; nomes com mais palavras primeiro ("Legacy Gems" antes de "Gems")
    order := []
    Loop 6 {
        n := 7 - A_Index
        for lab in labels
            if (StrSplit(Trim(RegExReplace(lab, "\s+", " ")), " ").Length = n)
                order.Push(lab)
    }

    for lab in order {
        toks := []
        for tk in StrSplit(Trim(RegExReplace(lab, "\s+", " ")), " ")
            toks.Push(NormTok(tk))
        best := 0, bestScore := 1e9, bestLab := 0
        Loop Max(0, words.Length - toks.Length + 1) {
            i := A_Index, ok := true
            for k, tk in toks {
                wd := words[i + k - 1]
                if (wd.used || !TokEq(wd.t, tk) || wd.line != words[i].line) {
                    ok := false
                    break
                }
            }
            if !ok
                continue
            ; retângulo do nome
            L := words[i], R := words[i + toks.Length - 1]
            lx := L.x, ly := Min(L.y, R.y), lw := R.x + R.w - L.x, lh := Max(L.h, R.h)
            ; número mais próximo
            for j, wd in words {
                if (wd.used || j >= i && j < i + toks.Length)
                    continue
                num := RegExReplace(wd.raw, "[^\d.,kKmMbB]+$")
                if !RegExMatch(num, "^\d[\d.,]*[kKmMbB]?$")
                    continue
                dy := ly - (wd.y + wd.h)
                if (dy >= -3 && dy <= lh * 3 && wd.x < lx + lw && wd.x + wd.w > lx - lh * 3)
                    sc := dy + Abs(wd.x - lx) * 0.5
                else if (wd.line = L.line && wd.x + wd.w <= lx)
                    sc := 1000 + (lx - wd.x - wd.w)
                else if (wd.line = L.line && wd.x >= lx + lw)
                    sc := 2000 + (wd.x - lx - lw)
                else
                    continue
                if (sc < bestScore)
                    bestScore := sc, best := j, bestLab := i
            }
        }
        if best {
            found[lab] := RegExReplace(words[best].raw, "[^\d.,kKmMbB]+$")
            words[best].used := true
            Loop toks.Length
                words[bestLab + A_Index - 1].used := true
        }
    }
    return found
}

; monta os campos do embed e atualiza a tela de "Última leitura"
; lê o campo "Gems=<:gems:123>|Gold|..." -> [{name, emoji}]
CurrencySpec() {
    global edCur
    out := []
    for part in StrSplit(edCur.Value, "|") {
        kv := StrSplit(part, "=", , 2)
        name := Trim(kv[1])
        if (name = "")
            continue
        emo := (kv.Length > 1) ? Trim(kv[2]) : ""
        out.Push({name: name, emoji: emo != "" ? emo : DefaultEmoji(name)})
    }
    return out
}

DefaultEmoji(name) {
    n := StrLower(name)
    if InStr(n, "legacy")
        return "💠"
    if InStr(n, "gem")
        return "💎"
    if InStr(n, "gold") || InStr(n, "coin")
        return "🪙"
    if InStr(n, "pearl")
        return "🫧"
    return "🔸"
}

; monta o bloco "Player Stats" do embed e atualiza a tela de "Última leitura"
CurrencyBlock(cur) {
    global prevCur, curView, aaMode
    if !aaMode
        return ""
    found := cur[2]
    out := "", view := ""
    for c in CurrencySpec() {
        lab := c.name
        if !found.Has(lab) {
            view .= lab ": " TT("not_found") "`n"
            continue
        }
        val := found[lab], delta := "", vdelta := ""
        n := ParseNum(val)
        if (n != "")
            val := FmtNum(n)
        if (n != "" && prevCur.Has(lab) && prevCur[lab] != "") {
            d := n - prevCur[lab]
            if d {
                delta := "  ``" (d > 0 ? "▲ +" : "▼ ") FmtNum(d) "``"
                vdelta := " (" (d > 0 ? "+" : "") FmtNum(d) ")"
            }
        }
        prevCur[lab] := n
        if (n != "")
            DayCoin(lab, n)
        out .= c.emoji "  **" val "**" delta "  ·  " lab "`n"
        view .= lab ": " val vdelta "`n"
    }
    curView.Value := view = "" ? TT("nothing_read") : RTrim(view, "`n")
    CoinsObserved(found)
    return out = "" ? "" : "### Player Stats`n" out
}

TestCurrencies() {
    global curView, lastOcrText
    hw := FindGameWindow()
    if !hw || WinGetMinMax(hw) = -1 {
        curView.Value := TT("ocr_open")
        return
    }
    try {
        cur := ReadCurrencies(hw)
        found := cur[2]
        view := ""
        for lab in cur[1]
            view .= lab ": " (found.Has(lab) ? found[lab] : TT("not_found")) "`n"
        curView.Value := view = "" ? TT("ocr_names") : RTrim(view, "`n")
        Log(TT("log_ocr_tested", found.Count, cur[1].Length))
        if (found.Count < cur[1].Length)
            Log(TT("log_ocr_saw") "`r`n" StrReplace(RTrim(lastOcrText, "`n"), "`n", "`r`n"))
    } catch as e {
        curView.Value := TT("ocr_err", e.Message)
        Log(TT("ocr_err", e.Message))
    }
}

ReportTick() {
    global running, chkRep
    if running && chkRep.Value
        SendStatusReport()
}

ApplyReportTimer() {
    global running, chkRep, edRepMin
    if (running && chkRep.Value) {
        m := Integer(edRepMin.Value || 60)
        if (m < 1)
            m := 1
        SetTimer(ReportTick, m * 60000)
    } else
